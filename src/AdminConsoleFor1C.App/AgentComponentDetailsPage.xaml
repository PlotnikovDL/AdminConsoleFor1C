<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="AdminConsoleFor1C.App.AgentComponentDetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:local="using:AdminConsoleFor1C.App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <x:Double x:Key="SettingsCardSpacing">4</x:Double>

        <Style
            x:Key="SettingsSectionHeaderTextBlockStyle"
            BasedOn="{StaticResource BodyStrongTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="Margin" Value="1,4,0,6" />
        </Style>
    </Page.Resources>

    <Grid HorizontalAlignment="Stretch">
        <StackPanel
            HorizontalAlignment="Stretch"
            Spacing="{StaticResource SettingsCardSpacing}">
                <InfoBar
                    IsOpen="{Binding HasError}"
                    Message="{Binding ErrorText}"
                    Severity="Error"
                    Title="Не удалось обновить агента"
                    Visibility="{Binding ErrorInfoBarVisibility}" />

                <InfoBar
                    Margin="0,8,0,0"
                    IsOpen="{Binding HasServiceOperationMessage}"
                    Message="{Binding ServiceOperationMessage}"
                    Severity="{Binding ServiceOperationSeverity}"
                    Title="{Binding ServiceOperationTitle}"
                    Visibility="{Binding ServiceOperationInfoBarVisibility}" />

                <TextBlock
                    Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                    Text="Действия" />

                <controls:SettingsCard
                    Description="Запуск, остановка и перезапуск службы Windows"
                    Header="Управление службой"
                    HorizontalAlignment="Stretch"
                    Visibility="{Binding SelectedComponentServiceActionsVisibility}">
                    <controls:SettingsCard.HeaderIcon>
                        <ic:FluentIcon
                            Icon="ServiceBell"
                            IconSize="Size20"
                            IconVariant="Regular" />
                    </controls:SettingsCard.HeaderIcon>

                    <CommandBar
                        Padding="0"
                        Background="Transparent"
                        DefaultLabelPosition="Right"
                        IsDynamicOverflowEnabled="True">
                        <AppBarButton
                            AutomationProperties.Name="Запустить службу Windows"
                            Command="{Binding StartSelectedServiceCommand}"
                            Label="Запустить"
                            ToolTipService.ToolTip="Запустить службу Windows">
                            <AppBarButton.Icon>
                                <ic:FluentIcon
                                    Icon="Play"
                                    IconSize="Size20"
                                    IconVariant="Regular" />
                            </AppBarButton.Icon>
                        </AppBarButton>

                        <AppBarButton
                            AutomationProperties.Name="Остановить службу Windows"
                            Command="{Binding StopSelectedServiceCommand}"
                            Label="Остановить"
                            ToolTipService.ToolTip="Остановить службу Windows">
                            <AppBarButton.Icon>
                                <ic:FluentIcon
                                    Icon="Stop"
                                    IconSize="Size20"
                                    IconVariant="Regular" />
                            </AppBarButton.Icon>
                        </AppBarButton>

                        <AppBarButton
                            AutomationProperties.Name="Перезапустить службу Windows"
                            Command="{Binding RestartSelectedServiceCommand}"
                            Label="Перезапустить"
                            ToolTipService.ToolTip="Перезапустить службу Windows">
                            <AppBarButton.Icon>
                                <ic:FluentIcon
                                    Icon="ArrowClockwise"
                                    IconSize="Size20"
                                    IconVariant="Regular" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                    </CommandBar>
                </controls:SettingsCard>

                <TextBlock
                    Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                    Text="Параметры службы" />

                <ItemsRepeater ItemsSource="{Binding SelectedComponent.Details}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="{StaticResource SettingsCardSpacing}" />
                    </ItemsRepeater.Layout>

                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="local:AgentComponentDetailItemViewModel">
                            <controls:SettingsCard
                                ContentAlignment="Right"
                                Description="{Binding Description}"
                                Header="{Binding Title}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Right">
                                <controls:SettingsCard.HeaderIcon>
                                    <ic:FluentIcon
                                        Icon="{Binding Icon}"
                                        IconSize="Size20"
                                        IconVariant="Regular" />
                                </controls:SettingsCard.HeaderIcon>

                                <TextBlock
                                    MaxWidth="520"
                                    HorizontalAlignment="Right"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    IsTextSelectionEnabled="True"
                                    Text="{Binding Value}"
                                    TextAlignment="Right"
                                    TextWrapping="WrapWholeWords" />
                            </controls:SettingsCard>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
        </StackPanel>
    </Grid>
</Page>

<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="AdminConsoleFor1C.App.InfobasesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ic="using:FluentIcons.WinUI" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
    <Page.Resources>
        <Style x:Key="InfobaseRowStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="12,10" />
        </Style>
    </Page.Resources>
    <Grid Padding="24,24,24,16" RowSpacing="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel Spacing="4">
            <TextBlock Text="Информационные базы" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <InfoBar IsOpen="{Binding ConnectionOwner.HasDiscoveryError}" Message="{Binding ConnectionOwner.DiscoveryError}" Severity="Warning" IsClosable="False" />
        </StackPanel>
            <Border x:Name="InfobaseWorkspace" Grid.Row="1" CornerRadius="8" BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource LayerFillColorDefaultBrush}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <CommandBar Padding="4,0" HorizontalAlignment="Left" Background="Transparent" DefaultLabelPosition="Right" IsDynamicOverflowEnabled="True">
                        <AppBarButton Label="Обновить" Command="{Binding RefreshCommand}" ToolTipService.ToolTip="Получить свежие данные для выбранных серверов, кластера и базы" AutomationProperties.AutomationId="RefreshInfobases">
                            <AppBarButton.Icon><ic:FluentIcon Icon="ArrowClockwise" IconSize="Size20" /></AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton Label="Добавить сервер" Click="AddServer_Click" IsEnabled="{Binding CanEdit}" AutomationProperties.AutomationId="AddServerConnection">
                            <AppBarButton.Icon><ic:FluentIcon Icon="Add" IconSize="Size20" /></AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton Label="Подключение" IsEnabled="{Binding CanEdit}" AutomationProperties.AutomationId="ServerConnectionMenu">
                            <AppBarButton.Icon><ic:FluentIcon Icon="Settings" IconSize="Size20" /></AppBarButton.Icon>
                            <AppBarButton.Flyout><MenuFlyout>
                                <MenuFlyoutItem Text="Обновить все серверы" Command="{Binding RefreshAllCommand}" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Изменить подключение…" Click="EditServer_Click" IsEnabled="{Binding CanManageSelected}" />
                                <MenuFlyoutItem Text="Удалить подключение…" Click="RemoveConnection_Click" IsEnabled="{Binding CanRemoveSelected}" />
                            </MenuFlyout></AppBarButton.Flyout>
                        </AppBarButton>
                        <AppBarToggleButton x:Name="AutoRefresh" Label="Автообновление" IsChecked="{Binding IsAutoRefreshEnabled, Mode=TwoWay}" ToolTipService.ToolTip="Обновлять выбранную область каждые 15 секунд, пока раздел открыт. При входе данные обновляются всегда.">
                            <AppBarToggleButton.Icon><ic:FluentIcon Icon="ArrowSync" IconSize="Size20" /></AppBarToggleButton.Icon>
                        </AppBarToggleButton>
                        <AppBarSeparator />
                        <AppBarButton Label="Создать базу" Click="Create_Click" IsEnabled="{Binding CanCreate}" ToolTipService.ToolTip="{Binding CreationHint}" AutomationProperties.AutomationId="CreateInfobase">
                            <AppBarButton.Icon><ic:FluentIcon Icon="Add" IconSize="Size20" /></AppBarButton.Icon>
                        </AppBarButton>
                    </CommandBar>
                    <InfoBar Grid.Row="1" IsOpen="{Binding HasMessage}" Message="{Binding Message}" Severity="{Binding MessageSeverity}" IsClosable="False" />
                    <InfoBar Grid.Row="2" IsOpen="{Binding HasConnectionError}" Message="{Binding ConnectionErrors}" Severity="{Binding ConnectionErrorSeverity}" IsClosable="False" Title="Подключение" />
                    <Grid x:Name="InfobaseFilters" Grid.Row="3" Margin="16,8,16,16" ColumnSpacing="16" RowSpacing="12" MaxWidth="1320" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
                        <ComboBox x:Name="ServerFilter" Header="Сервер" ItemsSource="{Binding ConnectionFilters}" SelectedItem="{Binding ConnectionFilter, Mode=TwoWay}" IsEnabled="{Binding CanEdit}"
                            ItemTemplate="{StaticResource ServerScopeFilterTemplate}" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="ServerFilter" />
                        <ComboBox x:Name="ClusterFilter" Grid.Column="1" Header="Кластер" ItemsSource="{Binding Clusters}" SelectedItem="{Binding SelectedCluster, Mode=TwoWay}" IsEnabled="{Binding CanEdit}"
                            ItemTemplate="{StaticResource ServerDataScopeFilterTemplate}" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="InfobaseClusterFilter" />
                        <ComboBox x:Name="BaseFilter" Grid.Column="2" Header="База" ItemsSource="{Binding InfobaseFilters}" SelectedItem="{Binding InfobaseFilter, Mode=TwoWay}" IsEnabled="{Binding CanEdit}"
                            ItemTemplate="{StaticResource ServerDataScopeFilterTemplate}" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="InfobaseFilter" />
                        <TextBox x:Name="SearchFilter" Grid.Column="3" Header="Поиск" PlaceholderText="Имя, описание, сервер или кластер" IsEnabled="{Binding CanEdit}"
                            Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="InfobaseSearch" />
                    </Grid>
                    <Grid Grid.Row="4">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <Grid MinWidth="1120">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <Grid Padding="12,10" ColumnSpacing="16" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="230" /><ColumnDefinition Width="240" /><ColumnDefinition Width="200" /><ColumnDefinition Width="240" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Имя базы" /><TextBlock Grid.Column="1" Text="Описание" /><TextBlock Grid.Column="2" Text="Сервер" /><TextBlock Grid.Column="3" Text="Кластер" /><TextBlock Grid.Column="4" Text="Платформа" />
                                </Grid>
                                <ListView x:Name="InfobasesList" Grid.Row="1" ItemsSource="{Binding Infobases}" SelectionMode="Single" ItemContainerStyle="{StaticResource InfobaseRowStyle}" AutomationProperties.AutomationId="InfobasesList">
                                    <ListView.ItemTemplate><DataTemplate>
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="230" /><ColumnDefinition Width="240" /><ColumnDefinition Width="200" /><ColumnDefinition Width="240" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding NameText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding NameText}" />
                                            <TextBlock Grid.Column="1" Text="{Binding DescriptionText}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding DescriptionText}" />
                                            <StackPanel Grid.Column="2" Spacing="2" ToolTipService.ToolTip="{Binding ServerDetails}">
                                                <TextBlock Text="{Binding ServerText}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Profile.AgentAddress}" FontSize="12" Opacity="0.75" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="3" Text="{Binding ClusterDisplayText}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding ClusterText}" />
                                            <TextBlock Grid.Column="4" Text="{Binding PlatformText}" />
                                        </Grid>
                                    </DataTemplate></ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </ScrollViewer>
                        <TextBlock x:Name="EmptyState" TextWrapping="Wrap" MaxWidth="520" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                    <Grid Grid.Row="5" Padding="16,10" ColumnSpacing="12" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding ListSummary}" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" />
                        <ProgressRing Grid.Column="1" IsActive="{Binding IsUpdating}" Width="16" Height="16" />
                    </Grid>
                </Grid>
            </Border>
    </Grid>
</Page>

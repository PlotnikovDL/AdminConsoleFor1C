<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="AdminConsoleFor1C.App.InfobasesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ic="using:FluentIcons.WinUI" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
    <Grid Padding="24,24,24,16" RowSpacing="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel Spacing="4">
            <TextBlock Text="Информационные базы" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <CommandBar Grid.Row="1" DefaultLabelPosition="Right" HorizontalAlignment="Left" Background="Transparent">
            <AppBarButton Label="Создать базу" Click="Create_Click" IsEnabled="{Binding CanCreate}" AutomationProperties.AutomationId="CreateInfobase">
                <AppBarButton.Icon><ic:FluentIcon Icon="Add" IconSize="Size20" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton Label="Обновить" Command="{Binding RefreshCommand}" AutomationProperties.AutomationId="RefreshInfobases">
                <AppBarButton.Icon><ic:FluentIcon Icon="ArrowClockwise" IconSize="Size20" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarButton Label="Добавить сервер" Click="AddServer_Click" IsEnabled="{Binding CanEdit}" AutomationProperties.AutomationId="AddInfobaseServer">
                <AppBarButton.Icon><ic:FluentIcon Icon="Server" IconSize="Size20" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton Label="Изменить подключение" Click="EditServer_Click" IsEnabled="{Binding CanRefresh}">
                <AppBarButton.Icon><ic:FluentIcon Icon="Settings" IconSize="Size20" /></AppBarButton.Icon>
            </AppBarButton>
        </CommandBar>
        <StackPanel Grid.Row="2" Spacing="12">
            <InfoBar IsOpen="{Binding ConnectionOwner.HasDiscoveryError}" Message="{Binding ConnectionOwner.DiscoveryError}" Severity="Warning" IsClosable="False" />
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <ComboBox Header="Сервер 1С и версия платформы" ItemsSource="{Binding Connections}" IsEnabled="{Binding CanEdit}"
                    SelectedItem="{Binding SelectedServer, Mode=TwoWay}" SelectionChanged="Server_SelectionChanged" DropDownOpened="Server_DropDownOpened"
                    PlaceholderText="Выберите сервер" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="InfobaseServer">
                    <ComboBox.ItemTemplate><DataTemplate>
                        <StackPanel Spacing="2"><TextBlock Text="{Binding Name}" /><TextBlock Text="{Binding AddressText}" FontSize="12" Opacity="0.75" /><TextBlock Text="{Binding SourceText}" FontSize="12" Opacity="0.75" /></StackPanel>
                    </DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
                <ComboBox Grid.Column="1" Header="Кластер 1С" ItemsSource="{Binding Clusters}" SelectedItem="{Binding SelectedCluster, Mode=TwoWay}" IsEnabled="{Binding CanEdit}"
                    PlaceholderText="Выберите кластер" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="InfobaseCluster" />
            </Grid>
            <TextBlock Text="{Binding ServerDetails}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <InfoBar IsOpen="{Binding HasMessage}" Message="{Binding Message}" Severity="{Binding MessageSeverity}" IsClosable="False" />
            <ProgressBar x:Name="LoadingProgress" IsIndeterminate="True" Visibility="Collapsed" />
        </StackPanel>
        <Border Grid.Row="3" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid RowSpacing="12" Padding="16">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*" MaxWidth="520" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBox Header="Поиск базы" PlaceholderText="Имя или описание" Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="InfobaseSearch" />
                </Grid>
                <Grid Grid.Row="1" Padding="12,4" ColumnSpacing="24">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Имя базы" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="1" Text="Описание" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
                <ListView x:Name="InfobasesList" Grid.Row="2" ItemsSource="{Binding Infobases}" SelectionMode="Single" AutomationProperties.AutomationId="InfobasesList">
                    <ListView.ItemContainerStyle><Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="12,10" />
                    </Style></ListView.ItemContainerStyle>
                    <ListView.ItemTemplate><DataTemplate>
                        <Grid ColumnSpacing="24"><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding NameText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding NameText}" />
                            <TextBlock Grid.Column="1" Text="{Binding DescriptionText}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </DataTemplate></ListView.ItemTemplate>
                </ListView>
                <TextBlock x:Name="EmptyState" Grid.Row="2" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Grid.Row="3" Text="{Binding ListSummary}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </Border>
    </Grid>
</Page>

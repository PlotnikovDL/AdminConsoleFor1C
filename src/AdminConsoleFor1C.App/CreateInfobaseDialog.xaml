<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog x:Class="AdminConsoleFor1C.App.CreateInfobaseDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Создание информационной базы" PrimaryButtonText="Далее" CloseButtonText="Отмена"
    DefaultButton="None" PrimaryButtonClick="Primary_Click" SecondaryButtonClick="Back_Click" Closing="Dialog_Closing">
    <ContentDialog.Resources><x:Double x:Key="ContentDialogMaxWidth">820</x:Double></ContentDialog.Resources>
    <ScrollViewer x:Name="FormScroll" VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="DialogBody" Spacing="16" Padding="0,0,12,0">
            <TextBlock x:Name="StepTitle" Text="1 из 2 · Параметры пустой серверной базы" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
            <InfoBar IsOpen="{Binding HasError}" Title="Создание базы" Message="{Binding Error}" Severity="Error" IsClosable="False" AutomationProperties.AutomationId="NewInfobaseError" />
            <TextBlock Text="{Binding TargetText}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            <StackPanel x:Name="FormPanel" Spacing="12">
                <TextBox Header="Имя информационной базы в кластере" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Например, Accounting_test" AutomationProperties.AutomationId="NewInfobaseName" />
                <TextBox Header="Описание" Text="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <ComboBox Header="Тип СУБД" ItemsSource="{Binding DbmsChoices}" SelectedItem="{Binding Dbms, Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="NewInfobaseDbms" />
                    <TextBox Grid.Column="1" Header="Сервер баз данных" Text="{Binding DbServer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="sql-server или host\instance" AutomationProperties.AutomationId="NewInfobaseDbServer" />
                </Grid>
                <TextBox Header="Имя базы данных в СУБД" Text="{Binding DbName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="NewInfobaseDbName" />
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBox Header="Пользователь СУБД" Text="{Binding DbUser, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="NewInfobaseDbUser" />
                    <PasswordBox x:Name="DatabasePassword" Grid.Column="1" Header="Пароль пользователя СУБД" AutomationProperties.AutomationId="NewInfobaseDbPassword" />
                </Grid>
                <CheckBox Content="Создать базу данных, если она отсутствует" IsChecked="{Binding CreateDatabase, Mode=TwoWay}" />
                <Expander Header="Дополнительные параметры" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" AutomationProperties.AutomationId="NewInfobaseAdvanced">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <ComboBox Header="Язык (страна)" ItemsSource="{Binding LocaleChoices}" SelectedItem="{Binding Locale, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                            <ComboBox Grid.Column="1" Header="Смещение дат" ItemsSource="{Binding DateOffsets}" SelectedItem="{Binding DateOffset, Mode=TwoWay}" HorizontalAlignment="Stretch"
                                IsEnabled="{Binding UsesDateOffset}" ToolTipService.ToolTip="Для Microsoft SQL Server. Конфигурациям с регистрами накопления или бухгалтерии требуется 2000." />
                        </Grid>
                        <ComboBox Header="Защищённое соединение" ItemsSource="{Binding SecurityChoices}" SelectedItem="{Binding Security, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                        <CheckBox Content="Блокировать выполнение регламентных заданий" IsChecked="{Binding ScheduledJobsDeny, Mode=TwoWay}" />
                        <CheckBox Content="Разрешить выдачу лицензий сервером 1С:Предприятия" IsChecked="{Binding LicenseDistribution, Mode=TwoWay}" />
                    </StackPanel>
                </Expander>
            </StackPanel>
            <TextBlock x:Name="ReviewPanel" Text="{Binding ReviewText}" TextWrapping="Wrap" Visibility="Collapsed" IsTextSelectionEnabled="True" AutomationProperties.AutomationId="NewInfobaseReview" />
            <ProgressBar x:Name="Progress" IsIndeterminate="True" Visibility="Collapsed" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>

<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="AdminConsoleFor1C.App.ProcessesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:local="using:AdminConsoleFor1C.App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <x:Double x:Key="SettingsCardSpacing">4</x:Double>

        <Style
            x:Key="SettingsSectionHeaderTextBlockStyle"
            BasedOn="{StaticResource BodyStrongTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="Margin" Value="1,4,0,6" />
        </Style>

        <Style
            x:Key="PageTitleTextBlockStyle"
            BasedOn="{StaticResource TitleTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Page.Resources>

    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled"
        VerticalScrollBarVisibility="Auto"
        VerticalScrollMode="Enabled">
        <Grid
            x:Name="PageLayoutRoot"
            Padding="48,44,48,48"
            HorizontalAlignment="Stretch">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="WideLayout">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="1180" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="PageLayoutRoot.Padding" Value="48,44,48,48" />
                        </VisualState.Setters>
                    </VisualState>

                    <VisualState x:Name="MediumLayout">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="720" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="PageLayoutRoot.Padding" Value="32,36,32,40" />
                        </VisualState.Setters>
                    </VisualState>

                    <VisualState x:Name="NarrowLayout">
                        <VisualState.Setters>
                            <Setter Target="PageLayoutRoot.Padding" Value="20,28,20,32" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <Grid
                MaxWidth="1000"
                HorizontalAlignment="Stretch">
                <StackPanel
                    HorizontalAlignment="Stretch"
                    Spacing="{StaticResource SettingsCardSpacing}">
                    <Grid RowSpacing="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Style="{StaticResource PageTitleTextBlockStyle}"
                            Text="Процессы" />

                        <Button
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Command="{Binding RefreshCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ic:FluentIcon
                                    Icon="ArrowClockwise"
                                    IconSize="Size16"
                                    IconVariant="Regular" />
                                <TextBlock Text="Обновить" />
                            </StackPanel>
                        </Button>

                        <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{Binding HeaderSubtitle}"
                                TextWrapping="WrapWholeWords" />

                            <ProgressRing
                                Grid.Column="1"
                                Width="20"
                                Height="20"
                                VerticalAlignment="Center"
                                IsActive="{Binding IsRefreshing}"
                                Visibility="{Binding RefreshProgressVisibility}" />
                        </Grid>
                    </Grid>

                    <InfoBar
                        IsOpen="{Binding HasError}"
                        Message="{Binding ErrorText}"
                        Severity="Error"
                        Title="Не удалось обновить процессы"
                        Visibility="{Binding ErrorInfoBarVisibility}" />

                    <TextBlock
                        Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                        Text="Процессы 1С" />

                    <controls:SettingsCard
                        Description="На этом компьютере не обнаружены процессы 1С"
                        Header="Процессы не найдены"
                        HorizontalAlignment="Stretch"
                        Visibility="{Binding EmptyStateVisibility}">
                        <controls:SettingsCard.HeaderIcon>
                            <ic:FluentIcon
                                Icon="AppsListDetail"
                                IconSize="Size20"
                                IconVariant="Regular" />
                        </controls:SettingsCard.HeaderIcon>

                        <TextBlock
                            FontWeight="SemiBold"
                            Text="{Binding ProcessesStatusText}" />
                    </controls:SettingsCard>

                    <ItemsRepeater
                        ItemsSource="{Binding Processes}"
                        Visibility="{Binding ProcessesListVisibility}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="{StaticResource SettingsCardSpacing}" />
                        </ItemsRepeater.Layout>

                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="local:AgentProcessItemViewModel">
                                <controls:SettingsExpander
                                    Description="{Binding Description}"
                                    Header="{Binding Title}"
                                    HorizontalAlignment="Stretch"
                                    IsExpanded="False"
                                    ItemsSource="{Binding Details}">
                                    <controls:SettingsExpander.HeaderIcon>
                                        <ic:FluentIcon
                                            Icon="{Binding Icon}"
                                            IconSize="Size20"
                                            IconVariant="Regular" />
                                    </controls:SettingsExpander.HeaderIcon>

                                    <controls:SettingsExpander.Content>
                                        <StackPanel
                                            MinWidth="128"
                                            HorizontalAlignment="Right"
                                            Spacing="2">
                                            <TextBlock
                                                HorizontalAlignment="Right"
                                                FontWeight="SemiBold"
                                                Text="{Binding ProcessIdText}"
                                                TextWrapping="NoWrap" />
                                            <TextBlock
                                                HorizontalAlignment="Right"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{Binding RoleText}"
                                                TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </controls:SettingsExpander.Content>

                                    <controls:SettingsExpander.ItemTemplate>
                                        <DataTemplate x:DataType="local:AgentProcessDetailItemViewModel">
                                            <controls:SettingsCard
                                                ContentAlignment="Right"
                                                Description="{Binding Description}"
                                                Header="{Binding Title}"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Right">
                                                <controls:SettingsCard.HeaderIcon>
                                                    <ic:FluentIcon
                                                        Icon="{Binding Icon}"
                                                        IconSize="Size20"
                                                        IconVariant="Regular" />
                                                </controls:SettingsCard.HeaderIcon>

                                                <TextBlock
                                                    MaxWidth="520"
                                                    HorizontalAlignment="Right"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    IsTextSelectionEnabled="True"
                                                    Text="{Binding Value}"
                                                    TextAlignment="Right"
                                                    TextWrapping="WrapWholeWords" />
                                            </controls:SettingsCard>
                                        </DataTemplate>
                                    </controls:SettingsExpander.ItemTemplate>
                                </controls:SettingsExpander>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>

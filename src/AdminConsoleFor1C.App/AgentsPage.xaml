<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="AdminConsoleFor1C.App.AgentsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:local="using:AdminConsoleFor1C.App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <x:Double x:Key="SettingsCardSpacing">4</x:Double>

        <Style
            x:Key="SettingsSectionHeaderTextBlockStyle"
            BasedOn="{StaticResource BodyStrongTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="Margin" Value="1,30,0,6" />
        </Style>
    </Page.Resources>

    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled"
        VerticalScrollBarVisibility="Auto"
        VerticalScrollMode="Enabled">
        <Grid
            Padding="48,44,48,48"
            HorizontalAlignment="Stretch">
            <StackPanel
                MaxWidth="1000"
                HorizontalAlignment="Stretch"
                Spacing="{StaticResource SettingsCardSpacing}">
                <StackPanel.ChildrenTransitions>
                    <EntranceThemeTransition FromVerticalOffset="32" />
                    <RepositionThemeTransition IsStaggeringEnabled="False" />
                </StackPanel.ChildrenTransitions>

                <Grid
                    ColumnSpacing="16"
                    RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        FontSize="34"
                        FontWeight="SemiBold"
                        Text="{Binding PageTitle}"
                        TextWrapping="WrapWholeWords" />

                    <StackPanel
                        Grid.Column="1"
                        Margin="0,4,0,0"
                        VerticalAlignment="Top"
                        Orientation="Horizontal"
                        Spacing="10">
                        <ProgressRing
                            Width="20"
                            Height="20"
                            IsActive="{Binding IsRefreshing}"
                            Visibility="{Binding RefreshProgressVisibility}" />
                        <Button Command="{Binding RefreshCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ic:FluentIcon
                                    Icon="ArrowClockwise"
                                    IconSize="Size16"
                                    IconVariant="Regular" />
                                <TextBlock Text="Обновить" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <TextBlock
                        Grid.Row="1"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{Binding StatusText}"
                        TextWrapping="WrapWholeWords" />
                </Grid>

                <InfoBar
                    Margin="0,18,0,0"
                    IsOpen="{Binding HasError}"
                    Message="{Binding ErrorText}"
                    Severity="Error"
                    Title="Не удалось обновить компоненты" />

                <TextBlock
                    Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                    Text="Агенты сервера 1С" />

                <controls:SettingsCard
                    Description="{Binding PageSubtitle}"
                    HorizontalAlignment="Stretch"
                    Header="Компоненты сервера"
                    Visibility="{Binding EmptyStateVisibility}">
                    <controls:SettingsCard.HeaderIcon>
                        <ic:FluentIcon
                            Icon="PuzzlePiece"
                            IconSize="Size20"
                            IconVariant="Regular" />
                    </controls:SettingsCard.HeaderIcon>

                    <TextBlock
                        FontWeight="SemiBold"
                        Text="{Binding ComponentsStatusText}" />
                </controls:SettingsCard>

                <ItemsRepeater
                    ItemsSource="{Binding Components}"
                    Visibility="{Binding ComponentsListVisibility}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="{StaticResource SettingsCardSpacing}" />
                    </ItemsRepeater.Layout>

                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="local:AgentComponentItemViewModel">
                            <controls:SettingsExpander
                                Description="{Binding SummaryDescription}"
                                HorizontalAlignment="Stretch"
                                Header="{Binding Title}"
                                IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                ItemsSource="{Binding Details}">
                                <controls:SettingsExpander.HeaderIcon>
                                    <ic:FluentIcon
                                        Icon="{Binding Icon}"
                                        IconSize="Size20"
                                        IconVariant="Regular" />
                                </controls:SettingsExpander.HeaderIcon>

                                <controls:SettingsExpander.Content>
                                    <StackPanel
                                        MinWidth="128"
                                        HorizontalAlignment="Right"
                                        Spacing="2">
                                        <TextBlock
                                            HorizontalAlignment="Right"
                                            FontWeight="SemiBold"
                                            Text="{Binding StatusText}"
                                            TextWrapping="NoWrap" />
                                        <TextBlock
                                            HorizontalAlignment="Right"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{Binding ProcessSummaryText}"
                                            TextWrapping="NoWrap" />
                                    </StackPanel>
                                </controls:SettingsExpander.Content>

                                <controls:SettingsExpander.ItemTemplate>
                                    <DataTemplate x:DataType="local:AgentComponentDetailItemViewModel">
                                        <controls:SettingsCard
                                            ContentAlignment="Right"
                                            Description="{Binding Description}"
                                            Header="{Binding Title}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Right">
                                            <controls:SettingsCard.HeaderIcon>
                                                <ic:FluentIcon
                                                    Icon="{Binding Icon}"
                                                    IconSize="Size20"
                                                    IconVariant="Regular" />
                                            </controls:SettingsCard.HeaderIcon>

                                            <TextBlock
                                                MaxWidth="520"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                HorizontalAlignment="Right"
                                                IsTextSelectionEnabled="True"
                                                Text="{Binding Value}"
                                                TextAlignment="Right"
                                                TextWrapping="WrapWholeWords" />
                                        </controls:SettingsCard>
                                    </DataTemplate>
                                </controls:SettingsExpander.ItemTemplate>
                            </controls:SettingsExpander>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>

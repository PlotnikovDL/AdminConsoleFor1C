<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="AdminConsoleFor1C.App.AgentProcessesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:local="using:AdminConsoleFor1C.App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <x:Double x:Key="SettingsCardSpacing">4</x:Double>

        <Style
            x:Key="SettingsSectionHeaderTextBlockStyle"
            BasedOn="{StaticResource BodyStrongTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="Margin" Value="1,30,0,6" />
        </Style>
    </Page.Resources>

    <Grid HorizontalAlignment="Stretch">
        <StackPanel
            HorizontalAlignment="Stretch"
            Spacing="{StaticResource SettingsCardSpacing}">
                <InfoBar
                    Margin="0,18,0,0"
                    IsOpen="{Binding HasError}"
                    Message="{Binding ErrorText}"
                    Severity="Error"
                    Title="Не удалось обновить компоненты" />

                <InfoBar
                    Margin="0,10,0,0"
                    IsOpen="{Binding HasServiceOperationMessage}"
                    Message="{Binding ServiceOperationMessage}"
                    Severity="{Binding ServiceOperationSeverity}"
                    Title="{Binding ServiceOperationTitle}" />

                <TextBlock
                    Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                    Text="Процессы 1С" />

                <ItemsRepeater ItemsSource="{Binding SelectedProcessGroup.Processes}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="{StaticResource SettingsCardSpacing}" />
                    </ItemsRepeater.Layout>

                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="local:AgentProcessItemViewModel">
                            <controls:SettingsExpander
                                Description="{Binding Description}"
                                Header="{Binding Title}"
                                HorizontalAlignment="Stretch"
                                IsExpanded="False"
                                ItemsSource="{Binding Details}">
                                <controls:SettingsExpander.HeaderIcon>
                                    <ic:FluentIcon
                                        Icon="{Binding Icon}"
                                        IconSize="Size20"
                                        IconVariant="Regular" />
                                </controls:SettingsExpander.HeaderIcon>

                                <controls:SettingsExpander.Content>
                                    <StackPanel
                                        MinWidth="128"
                                        HorizontalAlignment="Right"
                                        Spacing="2">
                                        <TextBlock
                                            HorizontalAlignment="Right"
                                            FontWeight="SemiBold"
                                            Text="{Binding ProcessIdText}"
                                            TextWrapping="NoWrap" />
                                        <TextBlock
                                            HorizontalAlignment="Right"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{Binding RoleText}"
                                            TextWrapping="NoWrap" />
                                    </StackPanel>
                                </controls:SettingsExpander.Content>

                                <controls:SettingsExpander.ItemTemplate>
                                    <DataTemplate x:DataType="local:AgentProcessDetailItemViewModel">
                                        <controls:SettingsCard
                                            ContentAlignment="Right"
                                            Description="{Binding Description}"
                                            Header="{Binding Title}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Right">
                                            <controls:SettingsCard.HeaderIcon>
                                                <ic:FluentIcon
                                                    Icon="{Binding Icon}"
                                                    IconSize="Size20"
                                                    IconVariant="Regular" />
                                            </controls:SettingsCard.HeaderIcon>

                                            <TextBlock
                                                MaxWidth="520"
                                                HorizontalAlignment="Right"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                IsTextSelectionEnabled="True"
                                                Text="{Binding Value}"
                                                TextAlignment="Right"
                                                TextWrapping="WrapWholeWords" />
                                        </controls:SettingsCard>
                                    </DataTemplate>
                                </controls:SettingsExpander.ItemTemplate>
                            </controls:SettingsExpander>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
        </StackPanel>
    </Grid>
</Page>

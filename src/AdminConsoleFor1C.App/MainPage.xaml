<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="AdminConsoleFor1C.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="4">
                <TextBlock
                    FontSize="28"
                    FontWeight="SemiBold"
                    Text="Службы" />
                <TextBlock
                    x:Name="StatusText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Готово" />
            </StackPanel>

            <ProgressRing
                x:Name="RefreshProgress"
                Grid.Column="1"
                Width="32"
                Height="32"
                IsActive="False"
                Visibility="Collapsed" />

            <Button
                x:Name="RefreshButton"
                Grid.Column="2"
                Click="RefreshButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Refresh" />
                    <TextBlock Text="Обновить" />
                </StackPanel>
            </Button>
        </Grid>

        <InfoBar
            x:Name="ErrorInfoBar"
            Grid.Row="1"
            IsOpen="False"
            Severity="Error"
            Title="Не удалось получить список служб" />

        <Grid Grid.Row="2">
            <ScrollViewer
                x:Name="ServicesTable"
                HorizontalScrollBarVisibility="Auto"
                HorizontalScrollMode="Enabled"
                VerticalScrollBarVisibility="Auto"
                VerticalScrollMode="Enabled">
                <StackPanel MinWidth="1180" Spacing="8">
                    <Border
                        Padding="12,8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" MinWidth="260" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="170" />
                            </Grid.ColumnDefinitions>

                            <TextBlock FontWeight="SemiBold" Text="Служба" />
                            <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="Состояние" />
                            <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="Версия" />
                            <TextBlock Grid.Column="3" FontWeight="SemiBold" Text="Порты" />
                            <TextBlock Grid.Column="4" FontWeight="SemiBold" Text="PID" />
                            <TextBlock Grid.Column="5" FontWeight="SemiBold" Text="Запуск" />
                            <TextBlock Grid.Column="6" FontWeight="SemiBold" Text="Учётная запись" />
                        </Grid>
                    </Border>

                    <ItemsRepeater x:Name="ServicesRepeater">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Margin="0,0,0,8"
                                    Padding="12,10"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                    <Grid RowSpacing="10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" MinWidth="260" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="180" />
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="130" />
                                                <ColumnDefinition Width="170" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Spacing="2">
                                                <TextBlock
                                                    FontWeight="SemiBold"
                                                    Text="{Binding KindDisplayName}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{Binding DisplayName}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <TextBlock
                                                Grid.Column="1"
                                                FontWeight="SemiBold"
                                                Text="{Binding StateDisplayName}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Grid.Column="2"
                                                Text="{Binding VersionText}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Grid.Column="3"
                                                Text="{Binding PortsText}"
                                                TextWrapping="WrapWholeWords" />
                                            <TextBlock
                                                Grid.Column="4"
                                                Text="{Binding ProcessIdText}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Grid.Column="5"
                                                Text="{Binding StartModeDisplayName}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Grid.Column="6"
                                                Text="{Binding AccountText}"
                                                TextTrimming="CharacterEllipsis" />
                                        </Grid>

                                        <Expander
                                            Grid.Row="1"
                                            Header="Подробности"
                                            IsExpanded="False">
                                            <StackPanel Spacing="10">
                                                <Grid ColumnSpacing="20" RowSpacing="2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <TextBlock
                                                        FontSize="12"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="Имя службы" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        FontSize="12"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="Каталог данных" />
                                                    <TextBlock
                                                        Grid.Row="1"
                                                        FontFamily="Consolas"
                                                        FontSize="12"
                                                        Text="{Binding Name}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        Grid.Row="1"
                                                        Grid.Column="1"
                                                        FontFamily="Consolas"
                                                        FontSize="12"
                                                        Text="{Binding DataDirectoryText}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </Grid>

                                                <Grid ColumnSpacing="20" RowSpacing="2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <TextBlock
                                                        FontSize="12"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="Исполняемый файл" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        FontSize="12"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="Аргументы" />
                                                    <TextBlock
                                                        Grid.Row="1"
                                                        FontFamily="Consolas"
                                                        FontSize="12"
                                                        Text="{Binding ExecutablePathText}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        Grid.Row="1"
                                                        Grid.Column="1"
                                                        FontFamily="Consolas"
                                                        FontSize="12"
                                                        Text="{Binding ArgumentsText}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                            </StackPanel>
                                        </Expander>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </ScrollViewer>

            <Border
                x:Name="EmptyState"
                MaxWidth="420"
                Padding="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Visibility="Collapsed">
                <StackPanel Spacing="6">
                    <TextBlock
                        FontSize="18"
                        FontWeight="SemiBold"
                        Text="Службы 1С не найдены" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Проверяются службы ragent, ras и dbgs, зарегистрированные в Windows."
                        TextWrapping="WrapWholeWords" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>

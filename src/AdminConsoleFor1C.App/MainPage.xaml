                                    <Button
                                        AutomationProperties.Name="Создать службу Windows для агента 1С"
                                        Click="ConfigureServerAgentServiceButton_Click"
                                        Tag="{Binding ServerAgentSetupCandidate}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <SymbolIcon Symbol="Add" />
                                            <TextBlock Text="Создать службу" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <Grid
                                ColumnSpacing="8"
                                Visibility="{Binding ServiceActionsVisibility}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel
                                    x:Name="ServiceActionsPanel"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <Button
                                        AutomationProperties.Name="Запустить службу 1С"
                                        Click="StartServiceButton_Click"
                                        IsEnabled="{Binding CanStartService}"
                                        Tag="{Binding}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <SymbolIcon Symbol="Play" />
                                            <TextBlock Text="Запустить" />
                                        </StackPanel>
                                    </Button>

                                    <Button
                                        AutomationProperties.Name="Остановить службу 1С"
                                        Click="StopServiceButton_Click"
                                        IsEnabled="{Binding CanStopService}"
                                        Tag="{Binding}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <SymbolIcon Symbol="Stop" />
                                            <TextBlock Text="Остановить" />
                                        </StackPanel>
                                    </Button>

                                    <Button
                                        AutomationProperties.Name="Перезапустить службу 1С"
                                        Click="RestartServiceButton_Click"
                                        IsEnabled="{Binding CanRestartService}"
                                        Tag="{Binding}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <SymbolIcon Symbol="Refresh" />
                                            <TextBlock Text="Перезапустить" />
                                        </StackPanel>
                                    </Button>

                                    <Button
                                        AutomationProperties.Name="Удалить службу 1С"
                                        Click="DeleteServiceButton_Click"
                                        IsEnabled="{Binding CanDeleteService}"
                                        Tag="{Binding}"
                                        ToolTipService.ToolTip="Удалить службу Windows">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <SymbolIcon Symbol="Delete" />
                                            <TextBlock Text="Удалить..." />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <ProgressRing
                                    x:Name="ServiceCommandProgress"
                                    Grid.Column="1"
                                    Width="28"
                                    Height="28"
                                    IsActive="False"
                                    Visibility="Collapsed" />
                            </Grid>

                            <Grid ColumnSpacing="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.1*" />
                                    <ColumnDefinition Width="0.8*" />
                                    <ColumnDefinition Width="1.5*" />
                                    <ColumnDefinition Width="1.2*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Spacing="4">
                                    <TextBlock
                                        Style="{StaticResource ColumnLabelTextBlockStyle}"
                                        Text="Состояние" />
                                    <Border
                                        MinHeight="28"
                                        Padding="8,0"
                                        HorizontalAlignment="Left"
                                        Background="{Binding StatusBadgeBackgroundBrush}"
                                        BorderBrush="{Binding StatusAccentBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                        <StackPanel
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            Spacing="6">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontWeight="SemiBold"
                                                LineHeight="20"
                                                Text="{Binding StateDisplayName}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        LineHeight="18"
                                        Text="{Binding StartModeDisplayName}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock
                                        Style="{StaticResource ColumnLabelTextBlockStyle}"
                                        Text="Версия" />
                                    <TextBlock
                                        LineHeight="20"
                                        Text="{Binding VersionText}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Spacing="4">
                                    <TextBlock
                                        Style="{StaticResource ColumnLabelTextBlockStyle}"
                                        Text="Порты" />
                                    <TextBlock
                                        LineHeight="20"
                                        Text="{Binding PortsText}"
                                        TextWrapping="WrapWholeWords" />
                                </StackPanel>

                                <StackPanel Grid.Column="3" Spacing="4">
                                    <TextBlock
                                        Style="{StaticResource ColumnLabelTextBlockStyle}"
                                        Text="Учётная запись" />
                                    <TextBlock
                                        LineHeight="20"
                                        Text="{Binding AccountText}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>

                            <Border
                                Height="1"
                                Background="{ThemeResource CardStrokeColorDefaultBrush}"
                                Visibility="{Binding WindowsNamesVisibility}" />

                            <StackPanel
                                Spacing="10"
                                Visibility="{Binding WindowsNamesVisibility}">
                                <TextBlock
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Text="Имена в Windows" />

                                <Grid ColumnSpacing="16" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock
                                        Style="{StaticResource MetadataLabelTextBlockStyle}"
                                        Text="В списке служб" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Style="{StaticResource MetadataValueTextBlockStyle}"
                                        Text="{Binding WindowsServicesDisplayNameText}"
                                        TextWrapping="WrapWholeWords" />

                                    <TextBlock
                                        Grid.Row="1"
                                        Style="{StaticResource MetadataLabelTextBlockStyle}"
                                        Text="Имя службы"
                                        Visibility="{Binding TaskManagerServiceNameVisibility}" />
                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Style="{StaticResource MetadataMonoTextBlockStyle}"
                                        Text="{Binding TaskManagerServiceNameText}"
                                        TextWrapping="WrapWholeWords"
                                        Visibility="{Binding TaskManagerServiceNameVisibility}" />
                                </Grid>
                            </StackPanel>

                            <Border
                                Height="1"
                                Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                            <StackPanel
                                Spacing="10"
                                Visibility="{Binding ProcessesSectionVisibility}">
                                <TextBlock
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Text="Файлы и запуск" />

                                <Grid ColumnSpacing="12" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock
                                        Style="{StaticResource MetadataLabelTextBlockStyle}"
                                        Text="Каталог данных" />
                                    <Button
                                        Grid.Column="1"
                                        AutomationProperties.Name="Копировать каталог данных"
                                        CommandParameter="Каталог данных"
                                        Click="CopyValueButton_Click"
                                        Style="{StaticResource CopyIconButtonStyle}"
                                        Tag="{Binding DataDirectoryText}"
                                        ToolTipService.ToolTip="Копировать каталог данных">
                                        <SymbolIcon Symbol="Copy" />
                                    </Button>
                                    <TextBlock
                                        Grid.Column="2"
                                        Style="{StaticResource MetadataMonoTextBlockStyle}"
                                        Text="{Binding DataDirectoryText}"
                                        TextWrapping="Wrap" />

                                    <TextBlock
                                        Grid.Row="1"
                                        Style="{StaticResource MetadataLabelTextBlockStyle}"
                                        Text="Исполняемый файл" />
                                    <Button
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        AutomationProperties.Name="Копировать исполняемый файл"
                                        CommandParameter="Исполняемый файл"
                                        Click="CopyValueButton_Click"
                                        Style="{StaticResource CopyIconButtonStyle}"
                                        Tag="{Binding ExecutablePathText}"
                                        ToolTipService.ToolTip="Копировать исполняемый файл">
                                        <SymbolIcon Symbol="Copy" />
                                    </Button>
                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="2"
                                        Style="{StaticResource MetadataMonoTextBlockStyle}"
                                        Text="{Binding ExecutablePathText}"
                                        TextWrapping="Wrap" />

                                    <TextBlock
                                        Grid.Row="2"
                                        Style="{StaticResource MetadataLabelTextBlockStyle}"
                                        Text="Аргументы" />
                                    <Button
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        AutomationProperties.Name="Копировать аргументы"
                                        CommandParameter="Аргументы"
                                        Click="CopyValueButton_Click"
                                        Style="{StaticResource CopyIconButtonStyle}"
                                        Tag="{Binding ArgumentsText}"
                                        ToolTipService.ToolTip="Копировать аргументы">
                                        <SymbolIcon Symbol="Copy" />
                                    </Button>
                                    <TextBlock
                                        Grid.Row="2"
                                        Grid.Column="2"
                                        Style="{StaticResource MetadataMonoTextBlockStyle}"
                                        Text="{Binding ArgumentsText}"
                                        TextWrapping="Wrap" />
                                </Grid>
                            </StackPanel>

                            <Border
                                Height="1"
                                Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                            <StackPanel Spacing="10">
                                <TextBlock
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Text="Процессы" />

                                <ItemsRepeater ItemsSource="{Binding Processes}">
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate>
                                            <Border
                                                Padding="0,10"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="0,1,0,0">
                                                <Grid ColumnSpacing="16">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="2*" />
                                                        <ColumnDefinition Width="80" />
                                                        <ColumnDefinition Width="90" />
                                                        <ColumnDefinition Width="2*" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Spacing="4">
                                                        <TextBlock
                                                            Style="{StaticResource SectionTitleTextBlockStyle}"
                                                            Text="{Binding KindDisplayName}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <TextBlock
                                                            Style="{StaticResource MetadataValueTextBlockStyle}"
                                                            Text="{Binding Name}"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="1" Spacing="4">
                                                        <TextBlock
                                                            Style="{StaticResource ColumnLabelTextBlockStyle}"
                                                            Text="PID" />
                                                        <TextBlock
                                                            FontWeight="SemiBold"
                                                            LineHeight="20"
                                                            Text="{Binding ProcessIdText}"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2" Spacing="4">
                                                        <TextBlock
                                                            Style="{StaticResource ColumnLabelTextBlockStyle}"
                                                            Text="Родитель" />
                                                        <TextBlock
                                                            LineHeight="20"
                                                            Text="{Binding ParentProcessIdText}"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="3" Spacing="4">
                                                        <TextBlock
                                                            Style="{StaticResource ColumnLabelTextBlockStyle}"
                                                            Text="Назначение" />
                                                        <TextBlock
                                                            LineHeight="20"
                                                            Text="{Binding RoleText}"
                                                            TextWrapping="WrapWholeWords" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>

            <Border
                x:Name="EmptyState"
                Width="640"
                MaxWidth="640"
                Padding="20"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Visibility="Collapsed">
                <StackPanel Spacing="6">
                    <TextBlock
                        FontSize="18"
                        FontWeight="SemiBold"
                        Text="Службы и процессы 1С не найдены" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Проверяются службы Windows и серверные процессы ragent, rmngr, rphost, ras и dbgs."
                        TextWrapping="WrapWholeWords" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
    </NavigationView>
</Page>

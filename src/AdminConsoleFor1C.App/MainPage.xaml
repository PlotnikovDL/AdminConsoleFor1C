<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="AdminConsoleFor1C.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="SectionTitleTextBlockStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LineHeight" Value="20" />
        </Style>

        <Style x:Key="MetadataLabelTextBlockStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
            <Setter Property="LineHeight" Value="18" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="MetadataValueTextBlockStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="LineHeight" Value="20" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="MetadataMonoTextBlockStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="LineHeight" Value="18" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ColumnLabelTextBlockStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="LineHeight" Value="18" />
        </Style>

        <Style x:Key="CopyIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Page.Resources>

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="4">
                <TextBlock
                    FontSize="28"
                    FontWeight="SemiBold"
                    Text="Компоненты сервера 1С" />
                <TextBlock
                    x:Name="StatusText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Готово" />
            </StackPanel>

            <ProgressRing
                x:Name="RefreshProgress"
                Grid.Column="1"
                Width="32"
                Height="32"
                IsActive="False"
                Visibility="Collapsed" />

            <Button
                x:Name="RefreshButton"
                Grid.Column="2"
                Click="RefreshButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Refresh" />
                    <TextBlock Text="Обновить" />
                </StackPanel>
            </Button>
        </Grid>

        <InfoBar
            x:Name="ErrorInfoBar"
            Grid.Row="1"
            IsOpen="False"
            Severity="Error"
            Title="Не удалось обновить компоненты 1С" />

        <Grid Grid.Row="2">
            <ScrollViewer
                x:Name="ServicesTable"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled"
                VerticalScrollBarVisibility="Auto"
                VerticalScrollMode="Enabled">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ItemsRepeater
                        x:Name="ServiceTreeRepeater"
                        HorizontalAlignment="Stretch">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Margin="0,0,0,8"
                                    Padding="16"
                                    HorizontalAlignment="Stretch"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                    <Grid RowSpacing="12">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="720" />
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="230" />
                                                <ColumnDefinition Width="170" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border
                                                Width="4"
                                                Height="32"
                                                VerticalAlignment="Top"
                                                Background="{Binding StatusAccentBrush}"
                                                CornerRadius="2" />

                                            <Button
                                                Grid.Column="1"
                                                Width="32"
                                                Height="32"
                                                Padding="0"
                                                VerticalAlignment="Top"
                                                Click="ToggleNodeButton_Click"
                                                Tag="{Binding}">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="18"
                                                    Text="{Binding ExpandGlyph}" />
                                            </Button>

                                            <Grid
                                                Grid.Column="2"
                                                ColumnSpacing="12"
                                                RowSpacing="4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="136" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <TextBlock
                                                    Grid.ColumnSpan="2"
                                                    Style="{StaticResource SectionTitleTextBlockStyle}"
                                                    Text="{Binding Title}"
                                                    TextTrimming="CharacterEllipsis" />

                                                <TextBlock
                                                    Grid.Row="1"
                                                    Style="{StaticResource MetadataLabelTextBlockStyle}"
                                                    Text="В списке служб" />
                                                <TextBlock
                                                    Grid.Row="1"
                                                    Grid.Column="1"
                                                    Style="{StaticResource MetadataValueTextBlockStyle}"
                                                    Text="{Binding WindowsServicesDisplayNameText}"
                                                    TextTrimming="CharacterEllipsis" />

                                                <TextBlock
                                                    Grid.Row="2"
                                                    Style="{StaticResource MetadataLabelTextBlockStyle}"
                                                    Text="Имя службы"
                                                    Visibility="{Binding TaskManagerServiceNameVisibility}" />
                                                <TextBlock
                                                    Grid.Row="2"
                                                    Grid.Column="1"
                                                    Style="{StaticResource MetadataMonoTextBlockStyle}"
                                                    Text="{Binding TaskManagerServiceNameText}"
                                                    TextTrimming="CharacterEllipsis"
                                                    Visibility="{Binding TaskManagerServiceNameVisibility}" />

                                                <TextBlock
                                                    Grid.Row="3"
                                                    Style="{StaticResource MetadataLabelTextBlockStyle}"
                                                    Text="Процессы"
                                                    Visibility="{Binding ProcessSummaryVisibility}" />

                                                <StackPanel
                                                    Grid.Row="3"
                                                    Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    Spacing="8"
                                                    Visibility="{Binding ProcessSummaryVisibility}">
                                                    <TextBlock
                                                        FontSize="12"
                                                        FontWeight="SemiBold"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="{Binding ProcessesSummaryText}" />
                                                    <TextBlock
                                                        FontSize="12"
                                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                        Text="{Binding ProcessNamesSummaryText}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Grid>

                                            <StackPanel Grid.Column="3" Spacing="4">
                                                <TextBlock
                                                    Style="{StaticResource ColumnLabelTextBlockStyle}"
                                                    Text="Состояние" />
                                                <Border
                                                    MinHeight="28"
                                                    Padding="8,0"
                                                    HorizontalAlignment="Left"
                                                    Background="{Binding StatusBadgeBackgroundBrush}"
                                                    BorderBrush="{Binding StatusAccentBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="10">
                                                    <StackPanel
                                                        VerticalAlignment="Center"
                                                        Orientation="Horizontal"
                                                        Spacing="6">
                                                        <Ellipse
                                                            Width="7"
                                                            Height="7"
                                                            VerticalAlignment="Center"
                                                            Fill="{Binding StatusAccentBrush}" />
                                                        <TextBlock
                                                            Margin="0,-1,0,0"
                                                            VerticalAlignment="Center"
                                                            FontWeight="SemiBold"
                                                            LineHeight="20"
                                                            Text="{Binding StateDisplayName}"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Border>
                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                    LineHeight="18"
                                                    Text="{Binding StartModeDisplayName}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="4" Spacing="4">
                                                <TextBlock
                                                    Style="{StaticResource ColumnLabelTextBlockStyle}"
                                                    Text="Версия" />
                                                <TextBlock
                                                    LineHeight="20"
                                                    Text="{Binding VersionText}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="5" Spacing="4">
                                                <TextBlock
                                                    Style="{StaticResource ColumnLabelTextBlockStyle}"
                                                    Text="Порты" />
                                                <TextBlock
                                                    LineHeight="20"
                                                    Text="{Binding PortsText}"
                                                    TextWrapping="WrapWholeWords" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="6" Spacing="4">
                                                <TextBlock
                                                    Style="{StaticResource ColumnLabelTextBlockStyle}"
                                                    Text="Учётная запись" />
                                                <TextBlock
                                                    LineHeight="20"
                                                    Text="{Binding AccountText}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <Button
                                                Grid.Column="7"
                                                AutomationProperties.Name="Открыть службы Windows"
                                                Padding="10,6"
                                                VerticalAlignment="Top"
                                                Click="OpenWindowsServicesButton_Click"
                                                Tag="{Binding}"
                                                ToolTipService.ToolTip="Открыть службы Windows">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <SymbolIcon Symbol="Setting" />
                                                    <TextBlock Text="Службы Windows" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>

                                        <Border
                                            Grid.Row="1"
                                            Margin="68,0,0,0"
                                            Padding="16,12"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Visibility="{Binding ServiceDetailsVisibility}">
                                            <Grid ColumnSpacing="16" RowSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="160" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <TextBlock
                                                    Style="{StaticResource MetadataLabelTextBlockStyle}"
                                                    Text="Каталог данных" />
                                                <TextBlock
                                                    Grid.Column="2"
                                                    Style="{StaticResource MetadataMonoTextBlockStyle}"
                                                    Text="{Binding DataDirectoryText}"
                                                    TextWrapping="Wrap" />
                                                <Button
                                                    Grid.Column="1"
                                                    AutomationProperties.Name="Копировать каталог данных"
                                                    CommandParameter="Каталог данных"
                                                    Click="CopyValueButton_Click"
                                                    Style="{StaticResource CopyIconButtonStyle}"
                                                    Tag="{Binding DataDirectoryText}"
                                                    ToolTipService.ToolTip="Копировать каталог данных">
                                                    <SymbolIcon Symbol="Copy" />
                                                </Button>

                                                <TextBlock
                                                    Grid.Row="1"
                                                    Style="{StaticResource MetadataLabelTextBlockStyle}"
                                                    Text="Исполняемый файл" />
                                                <TextBlock
                                                    Grid.Row="1"
                                                    Grid.Column="2"
                                                    Style="{StaticResource MetadataMonoTextBlockStyle}"
                                                    Text="{Binding ExecutablePathText}"
                                                    TextWrapping="Wrap" />
                                                <Button
                                                    Grid.Row="1"
                                                    Grid.Column="1"
                                                    AutomationProperties.Name="Копировать исполняемый файл"
                                                    CommandParameter="Исполняемый файл"
                                                    Click="CopyValueButton_Click"
                                                    Style="{StaticResource CopyIconButtonStyle}"
                                                    Tag="{Binding ExecutablePathText}"
                                                    ToolTipService.ToolTip="Копировать исполняемый файл">
                                                    <SymbolIcon Symbol="Copy" />
                                                </Button>

                                                <TextBlock
                                                    Grid.Row="2"
                                                    Style="{StaticResource MetadataLabelTextBlockStyle}"
                                                    Text="Аргументы" />
                                                <TextBlock
                                                    Grid.Row="2"
                                                    Grid.Column="2"
                                                    Style="{StaticResource MetadataMonoTextBlockStyle}"
                                                    Text="{Binding ArgumentsText}"
                                                    TextTrimming="CharacterEllipsis"
                                                    TextWrapping="NoWrap" />
                                                <Button
                                                    Grid.Row="2"
                                                    Grid.Column="1"
                                                    AutomationProperties.Name="Копировать аргументы"
                                                    CommandParameter="Аргументы"
                                                    Click="CopyValueButton_Click"
                                                    Style="{StaticResource CopyIconButtonStyle}"
                                                    Tag="{Binding ArgumentsText}"
                                                    ToolTipService.ToolTip="Копировать аргументы">
                                                    <SymbolIcon Symbol="Copy" />
                                                </Button>
                                            </Grid>
                                        </Border>

                                        <Border
                                            Grid.Row="2"
                                            Margin="68,0,0,0"
                                            Padding="16,10"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Visibility="{Binding ProcessesVisibility}">
                                            <Grid RowSpacing="8">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <ItemsRepeater ItemsSource="{Binding Processes}">
                                                    <ItemsRepeater.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border
                                                                Padding="0,10"
                                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                BorderThickness="0,1,0,0">
                                                                <Grid ColumnSpacing="16">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="360" />
                                                                        <ColumnDefinition Width="80" />
                                                                        <ColumnDefinition Width="90" />
                                                                        <ColumnDefinition Width="230" />
                                                                    </Grid.ColumnDefinitions>

                                                                    <StackPanel Spacing="4">
                                                                        <TextBlock
                                                                            Style="{StaticResource SectionTitleTextBlockStyle}"
                                                                            Text="{Binding KindDisplayName}"
                                                                            TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock
                                                                            Style="{StaticResource MetadataValueTextBlockStyle}"
                                                                            Text="{Binding Name}"
                                                                            TextTrimming="CharacterEllipsis" />
                                                                    </StackPanel>

                                                                    <StackPanel Grid.Column="1" Spacing="4">
                                                                        <TextBlock
                                                                            Style="{StaticResource ColumnLabelTextBlockStyle}"
                                                                            Text="PID" />
                                                                        <TextBlock
                                                                            FontWeight="SemiBold"
                                                                            LineHeight="20"
                                                                            Text="{Binding ProcessIdText}"
                                                                            TextTrimming="CharacterEllipsis" />
                                                                    </StackPanel>

                                                                    <StackPanel Grid.Column="2" Spacing="4">
                                                                        <TextBlock
                                                                            Style="{StaticResource ColumnLabelTextBlockStyle}"
                                                                            Text="Родитель" />
                                                                        <TextBlock
                                                                            LineHeight="20"
                                                                            Text="{Binding ParentProcessIdText}"
                                                                            TextTrimming="CharacterEllipsis" />
                                                                    </StackPanel>

                                                                    <StackPanel Grid.Column="3" Spacing="4">
                                                                        <TextBlock
                                                                            Style="{StaticResource ColumnLabelTextBlockStyle}"
                                                                            Text="Назначение" />
                                                                        <TextBlock
                                                                            LineHeight="20"
                                                                            Text="{Binding RoleText}"
                                                                            TextWrapping="WrapWholeWords" />
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsRepeater.ItemTemplate>
                                                </ItemsRepeater>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </Grid>
            </ScrollViewer>

            <Border
                x:Name="EmptyState"
                MaxWidth="420"
                Padding="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Visibility="Collapsed">
                <StackPanel Spacing="6">
                    <TextBlock
                        FontSize="18"
                        FontWeight="SemiBold"
                        Text="Службы и процессы 1С не найдены" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Проверяются службы Windows и серверные процессы ragent, rmngr, rphost, ras и dbgs."
                        TextWrapping="WrapWholeWords" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>

<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="AdminConsoleFor1C.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="SectionTitleTextBlockStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LineHeight" Value="20" />
        </Style>

        <Style x:Key="MetadataLabelTextBlockStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
            <Setter Property="LineHeight" Value="18" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="MetadataValueTextBlockStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="LineHeight" Value="20" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="MetadataMonoTextBlockStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="LineHeight" Value="18" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ColumnLabelTextBlockStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="LineHeight" Value="18" />
        </Style>

        <Style x:Key="CopyIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Page.Resources>

    <NavigationView
        x:Name="RootNavigation"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        PaneDisplayMode="Left"
        SelectionChanged="RootNavigation_SelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem
                x:Name="AgentsNavigationItem"
                Content="Агенты сервера 1С"
                Tag="agents">
                <NavigationViewItem.Icon>
                    <PathIcon Data="M9.25 6C8.83579 6 8.5 6.33579 8.5 6.75C8.5 7.16421 8.83579 7.5 9.25 7.5H14.75C15.1642 7.5 15.5 7.16421 15.5 6.75C15.5 6.33579 15.1642 6 14.75 6H9.25ZM8.5 17.75C8.5 17.3358 8.83579 17 9.25 17H14.75C15.1642 17 15.5 17.3358 15.5 17.75C15.5 18.1642 15.1642 18.5 14.75 18.5H9.25C8.83579 18.5 8.5 18.1642 8.5 17.75ZM9.25 14C8.83579 14 8.5 14.3358 8.5 14.75C8.5 15.1642 8.83579 15.5 9.25 15.5H14.75C15.1642 15.5 15.5 15.1642 15.5 14.75C15.5 14.3358 15.1642 14 14.75 14H9.25ZM6 5C6 3.34315 7.34315 2 9 2H15C16.6569 2 18 3.34315 18 5V19C18 20.6569 16.6569 22 15 22H9C7.34315 22 6 20.6569 6 19V5ZM9 3.5C8.17157 3.5 7.5 4.17157 7.5 5V19C7.5 19.8284 8.17157 20.5 9 20.5H15C15.8284 20.5 16.5 19.8284 16.5 19V5C16.5 4.17157 15.8284 3.5 15 3.5H9Z" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem
                x:Name="InfobasesNavigationItem"
                Content="Информационные базы"
                Tag="infobases">
                <NavigationViewItem.Icon>
                    <PathIcon Data="M4 6C4 5.30945 4.3153 4.70664 4.77423 4.22025C5.2294 3.73784 5.85301 3.33745 6.56668 3.01752C7.99575 2.3769 9.91738 2 12 2C14.0826 2 16.0042 2.3769 17.4333 3.01752C18.147 3.33745 18.7706 3.73784 19.2258 4.22025C19.6847 4.70664 20 5.30945 20 6V18C20 18.6906 19.6847 19.2934 19.2258 19.7798C18.7706 20.2622 18.147 20.6626 17.4333 20.9825C16.0042 21.6231 14.0826 22 12 22C9.91738 22 7.99575 21.6231 6.56668 20.9825C5.85301 20.6626 5.2294 20.2622 4.77423 19.7798C4.3153 19.2934 4 18.6906 4 18V6ZM5.5 6C5.5 6.20691 5.59044 6.45909 5.86525 6.75034C6.14382 7.04559 6.58195 7.3455 7.18027 7.61372C8.37519 8.14937 10.0786 8.5 12 8.5C13.9214 8.5 15.6248 8.14937 16.8197 7.61372C17.418 7.3455 17.8562 7.04559 18.1348 6.75034C18.4096 6.45909 18.5 6.20691 18.5 6C18.5 5.79309 18.4096 5.54091 18.1348 5.24966C17.8562 4.95441 17.418 4.65449 16.8197 4.38628C15.6248 3.85063 13.9214 3.5 12 3.5C10.0786 3.5 8.37519 3.85063 7.18027 4.38628C6.58195 4.65449 6.14382 4.95441 5.86525 5.24966C5.59044 5.54091 5.5 5.79309 5.5 6ZM18.5 8.39242C18.1791 8.61282 17.8194 8.80942 17.4333 8.98248C16.0042 9.6231 14.0826 10 12 10C9.91738 10 7.99575 9.6231 6.56668 8.98248C6.18063 8.80942 5.82094 8.61282 5.5 8.39242V18C5.5 18.2069 5.59044 18.4591 5.86525 18.7503C6.14382 19.0456 6.58195 19.3455 7.18027 19.6137C8.37519 20.1494 10.0786 20.5 12 20.5C13.9214 20.5 15.6248 20.1494 16.8197 19.6137C17.418 19.3455 17.8562 19.0456 18.1348 18.7503C18.4096 18.4591 18.5 18.2069 18.5 18V8.39242Z" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem
                x:Name="SessionsNavigationItem"
                Content="Сеансы"
                Tag="sessions">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE716;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem
                x:Name="LicensesNavigationItem"
                Content="Лицензии"
                Tag="licenses">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE8D7;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem
                x:Name="SettingsNavigationItem"
                Content="Настройки"
                Tag="settings">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE713;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="4">
                <TextBlock
                    x:Name="PageTitleText"
                    FontSize="28"
                    FontWeight="SemiBold"
                    Text="Агенты сервера 1С" />
                <TextBlock
                    x:Name="StatusText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Готово" />
            </StackPanel>

            <ProgressRing
                x:Name="RefreshProgress"
                Grid.Column="1"
                Width="32"
                Height="32"
                IsActive="False"
                Visibility="Collapsed" />

            <Button
                x:Name="RefreshButton"
                Grid.Column="2"
                Click="RefreshButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Refresh" />
                    <TextBlock Text="Обновить" />
                </StackPanel>
            </Button>

            <Button
                x:Name="OpenWindowsServicesButton"
                Grid.Column="3"
                Click="OpenWindowsServicesButton_Click"
                ToolTipService.ToolTip="Открыть службы Windows">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Setting" />
                    <TextBlock Text="Службы Windows" />
                </StackPanel>
            </Button>
        </Grid>

        <InfoBar
            x:Name="ErrorInfoBar"
            Grid.Row="1"
            IsOpen="False"
            Severity="Error"
            Title="Не удалось обновить компоненты 1С" />

        <Grid Grid.Row="2">
            <Grid
                x:Name="ContentGrid"
                ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ServiceListColumn" Width="520" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ScrollViewer
                    x:Name="ServicesTable"
                    HorizontalScrollBarVisibility="Disabled"
                    HorizontalScrollMode="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    VerticalScrollMode="Enabled">
                    <StackPanel Spacing="0">
                        <ItemsRepeater
                            x:Name="ServiceTreeRepeater"
                            HorizontalAlignment="Stretch">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Margin="0,0,0,12"
                                        Padding="14"
                                        HorizontalAlignment="Stretch"
                                        Background="{Binding CardBackgroundBrush}"
                                        BorderBrush="{Binding CardBorderBrush}"
                                        BorderThickness="{Binding CardBorderThickness}"
                                        CornerRadius="6"
                                        Tag="{Binding}"
                                        Tapped="ServiceNode_Tapped">
                                        <Grid ColumnSpacing="14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border
                                                Width="4"
                                                MinHeight="44"
                                                VerticalAlignment="Stretch"
                                                Background="{Binding StatusAccentBrush}"
                                                CornerRadius="2" />

                                            <StackPanel
                                                Grid.Column="1"
                                                Spacing="4"
                                                VerticalAlignment="Center">
                                                <TextBlock
                                                    Style="{StaticResource SectionTitleTextBlockStyle}"
                                                    Text="{Binding Title}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Style="{StaticResource MetadataValueTextBlockStyle}"
                                                    Text="{Binding WindowsServicesDisplayNameText}"
                                                    TextTrimming="CharacterEllipsis"
                                                    MaxLines="1" />
                                                <Grid
                                                    ColumnSpacing="6"
                                                    Visibility="{Binding ProcessSummaryVisibility}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        FontSize="12"
                                                        FontWeight="SemiBold"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="{Binding ProcessesSummaryText}" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        FontSize="12"
                                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                        Text="{Binding ProcessNamesSummaryText}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                                <TextBlock
                                                    Style="{StaticResource MetadataMonoTextBlockStyle}"
                                                    Text="{Binding CandidateExecutablePathText}"
                                                    TextTrimming="CharacterEllipsis"
                                                    Visibility="{Binding CandidateExecutablePathVisibility}" />
                                            </StackPanel>

                                            <Border
                                                Grid.Column="2"
                                                MinWidth="116"
                                                MinHeight="30"
                                                Padding="12,5"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Background="{Binding StatusChipBackgroundBrush}"
                                                CornerRadius="6">
                                                <StackPanel
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal"
                                                    Spacing="8">
                                                    <Border
                                                        Width="14"
                                                        Height="14"
                                                        VerticalAlignment="Center"
                                                        Background="{Binding StatusAccentBrush}"
                                                        CornerRadius="7"
                                                        Visibility="{Binding StatusReadyIconVisibility}">
                                                        <SymbolIcon
                                                            Width="10"
                                                            Height="10"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Foreground="White"
                                                            Symbol="Accept" />
                                                    </Border>
                                                    <Ellipse
                                                        Width="8"
                                                        Height="8"
                                                        VerticalAlignment="Center"
                                                        Fill="{Binding StatusAccentBrush}"
                                                        Visibility="{Binding StatusFallbackDotVisibility}" />
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        Foreground="{Binding StatusTextBrush}"
                                                        FontWeight="SemiBold"
                                                        LineHeight="20"
                                                        Text="{Binding StateDisplayName}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </ScrollViewer>

                <Grid
                    Grid.Column="1"
                    RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border
                        x:Name="AdministrationToolsCard"
                        Grid.Row="1"
                        Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <StackPanel Spacing="12">
                            <StackPanel Spacing="2">
                                <TextBlock
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Text="Инструменты администрирования" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    LineHeight="20"
                                    Text="{Binding SummaryText}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <Grid ColumnSpacing="16" RowSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Spacing="2">
                                    <TextBlock
                                        Style="{StaticResource SectionTitleTextBlockStyle}"
                                        Text="rac.exe" />
                                    <TextBlock
                                        Style="{StaticResource ColumnLabelTextBlockStyle}"
                                        Text="команды" />
                                </StackPanel>

                                <Border
                                    Grid.Column="1"
                                    MinHeight="26"
                                    Padding="8,0"
                                    HorizontalAlignment="Left"
                                    Background="{Binding RacStatusBadgeBackgroundBrush}"
                                    BorderBrush="{Binding RacStatusAccentBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                    <StackPanel
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="6">
                                        <Ellipse
                                            Width="7"
                                            Height="7"
                                            VerticalAlignment="Center"
                                            Fill="{Binding RacStatusAccentBrush}" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            LineHeight="18"
                                            Text="{Binding RacStateText}" />
                                    </StackPanel>
                                </Border>

                                <TextBlock
                                    Grid.Column="2"
                                    LineHeight="20"
                                    Text="{Binding RacVersionText}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Grid.Column="3"
                                    Style="{StaticResource MetadataMonoTextBlockStyle}"
                                    Text="{Binding RacPathText}"
                                    TextTrimming="CharacterEllipsis" />

                                <StackPanel Grid.Row="1" Spacing="2">
                                    <TextBlock
                                        Style="{StaticResource SectionTitleTextBlockStyle}"
                                        Text="ras.exe" />
                                    <TextBlock
                                        Style="{StaticResource ColumnLabelTextBlockStyle}"
                                        Text="сервер" />
                                </StackPanel>

                                <Border
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    MinHeight="26"
                                    Padding="8,0"
                                    HorizontalAlignment="Left"
                                    Background="{Binding RasStatusBadgeBackgroundBrush}"
                                    BorderBrush="{Binding RasStatusAccentBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                    <StackPanel
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="6">
                                        <Ellipse
                                            Width="7"
                                            Height="7"
                                            VerticalAlignment="Center"
                                            Fill="{Binding RasStatusAccentBrush}" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            LineHeight="18"
                                            Text="{Binding RasStateText}" />
                                    </StackPanel>
                                </Border>

                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="2"
                                    LineHeight="20"
                                    Text="{Binding RasVersionText}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="3"
                                    Style="{StaticResource MetadataMonoTextBlockStyle}"
                                    Text="{Binding RasPathText}"
                                    TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border
                        x:Name="InfobasesCard"
                        Grid.Row="0"
                        Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Visibility="Collapsed">
                        <StackPanel Spacing="12">
                            <StackPanel Spacing="2">
                                <TextBlock
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Text="Информационные базы" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    LineHeight="20"
                                    Text="{Binding InfobasesSummaryText}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <Border
                                Padding="14"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Visibility="{Binding InfobasesEmptyStateVisibility}">
                                <StackPanel Spacing="4">
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        LineHeight="20"
                                        Text="Информационные базы не найдены" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        LineHeight="20"
                                        Text="{Binding MessageText}"
                                        TextWrapping="WrapWholeWords" />
                                </StackPanel>
                            </Border>

                            <ItemsRepeater
                                ItemsSource="{Binding Clusters}"
                                Visibility="{Binding InfobaseClustersVisibility}">
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Padding="0,12"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="0,1,0,0">
                                            <StackPanel Spacing="10">
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Spacing="2">
                                                        <TextBlock
                                                            Style="{StaticResource SectionTitleTextBlockStyle}"
                                                            Text="{Binding NameText}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <TextBlock
                                                            Style="{StaticResource ColumnLabelTextBlockStyle}"
                                                            Text="{Binding AddressText}"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>

                                                    <Button
                                                        Grid.Column="1"
                                                        HorizontalAlignment="Right"
                                                        AutomationProperties.Name="Создать информационную базу"
                                                        Click="OpenCreateInfobaseDialogButton_Click"
                                                        Tag="{Binding}">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <SymbolIcon Symbol="Add" />
                                                            <TextBlock Text="Создать базу" />
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>

                                                <Border
                                                    Padding="14"
                                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Visibility="{Binding InfobaseEmptyStateVisibility}">
                                                    <StackPanel Spacing="4">
                                                        <TextBlock
                                                            FontWeight="SemiBold"
                                                            LineHeight="20"
                                                            Text="Баз пока нет" />
                                                        <TextBlock
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            LineHeight="20"
                                                            Text="Создайте регистрацию информационной базы в выбранном кластере."
                                                            TextWrapping="WrapWholeWords" />
                                                    </StackPanel>
                                                </Border>

                                                <ItemsRepeater
                                                    ItemsSource="{Binding Infobases}"
                                                    Visibility="{Binding InfobasesVisibility}">
                                                    <ItemsRepeater.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border
                                                                Margin="0,0,0,8"
                                                                Padding="14"
                                                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="6">
                                                                <Grid ColumnSpacing="16">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="1.3*" />
                                                                        <ColumnDefinition Width="1.5*" />
                                                                        <ColumnDefinition Width="1.1*" />
                                                                        <ColumnDefinition Width="220" />
                                                                    </Grid.ColumnDefinitions>

                                                                    <StackPanel Spacing="4">
                                                                        <TextBlock
                                                                            Style="{StaticResource SectionTitleTextBlockStyle}"
                                                                            Text="{Binding NameText}"
                                                                            TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock
                                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                            LineHeight="20"
                                                                            Text="{Binding DescriptionText}"
                                                                            TextWrapping="WrapWholeWords" />
                                                                        <TextBlock
                                                                            Style="{StaticResource MetadataMonoTextBlockStyle}"
                                                                            Text="{Binding UuidText}"
                                                                            TextTrimming="CharacterEllipsis" />
                                                                    </StackPanel>

                                                                    <StackPanel Grid.Column="1" Spacing="4">
                                                                        <TextBlock
                                                                            Style="{StaticResource ColumnLabelTextBlockStyle}"
                                                                            Text="Хранилище данных" />
                                                                        <TextBlock
                                                                            LineHeight="20"
                                                                            Text="{Binding DatabaseText}"
                                                                            TextWrapping="WrapWholeWords" />
                                                                    </StackPanel>

                                                                    <StackPanel Grid.Column="2" Spacing="4">
                                                                        <TextBlock
                                                                            Style="{StaticResource ColumnLabelTextBlockStyle}"
                                                                            Text="Ограничения" />
                                                                        <TextBlock
                                                                            LineHeight="20"
                                                                            Text="{Binding RestrictionsText}"
                                                                            TextWrapping="WrapWholeWords" />
                                                                    </StackPanel>

                                                                    <StackPanel Grid.Column="3" Spacing="10">
                                                                        <Button
                                                                            HorizontalAlignment="Stretch"
                                                                            Click="OpenTransferInfobaseDialogButton_Click"
                                                                            Tag="{Binding}">
                                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                                <SymbolIcon Symbol="Forward" />
                                                                                <TextBlock Text="Перенести..." />
                                                                            </StackPanel>
                                                                        </Button>

                                                                        <Grid
                                                                            MinHeight="34"
                                                                            ColumnSpacing="12">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <StackPanel
                                                                                VerticalAlignment="Center"
                                                                                Spacing="1">
                                                                                <TextBlock
                                                                                    FontWeight="SemiBold"
                                                                                    Text="Вход пользователей" />
                                                                                <TextBlock
                                                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                                    Text="{Binding SessionsAccessText}" />
                                                                            </StackPanel>
                                                                            <ToggleSwitch
                                                                                Grid.Column="1"
                                                                                MinWidth="0"
                                                                                HorizontalAlignment="Right"
                                                                                VerticalAlignment="Center"
                                                                                OffContent=""
                                                                                OnContent=""
                                                                                Tag="{Binding}"
                                                                                Loaded="InfobaseSessionsToggleSwitch_Loaded"
                                                                                Unloaded="InfobaseSessionsToggleSwitch_Unloaded" />
                                                                        </Grid>

                                                                        <Grid
                                                                            MinHeight="34"
                                                                            ColumnSpacing="12">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <StackPanel
                                                                                VerticalAlignment="Center"
                                                                                Spacing="1">
                                                                                <TextBlock
                                                                                    FontWeight="SemiBold"
                                                                                    Text="Регламентные задания" />
                                                                                <TextBlock
                                                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                                    Text="{Binding ScheduledJobsAccessText}" />
                                                                            </StackPanel>

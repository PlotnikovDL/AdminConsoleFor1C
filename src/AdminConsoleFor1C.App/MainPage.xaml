<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="AdminConsoleFor1C.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="SectionTitleTextBlockStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LineHeight" Value="20" />
        </Style>

        <Style x:Key="MetadataLabelTextBlockStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
            <Setter Property="LineHeight" Value="18" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="MetadataValueTextBlockStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="LineHeight" Value="20" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="MetadataMonoTextBlockStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="LineHeight" Value="18" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ColumnLabelTextBlockStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="LineHeight" Value="18" />
        </Style>

        <Style x:Key="CopyIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Page.Resources>

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="4">
                <TextBlock
                    FontSize="28"
                    FontWeight="SemiBold"
                    Text="Компоненты сервера 1С" />
                <TextBlock
                    x:Name="StatusText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Готово" />
            </StackPanel>

            <ProgressRing
                x:Name="RefreshProgress"
                Grid.Column="1"
                Width="32"
                Height="32"
                IsActive="False"
                Visibility="Collapsed" />

            <Button
                x:Name="RefreshButton"
                Grid.Column="2"
                Click="RefreshButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Refresh" />
                    <TextBlock Text="Обновить" />
                </StackPanel>
            </Button>
        </Grid>

        <InfoBar
            x:Name="ErrorInfoBar"
            Grid.Row="1"
            IsOpen="False"
            Severity="Error"
            Title="Не удалось обновить компоненты 1С" />

        <Grid Grid.Row="2">
            <Grid
                x:Name="ContentGrid"
                ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="640" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ScrollViewer
                    x:Name="ServicesTable"
                    HorizontalScrollBarVisibility="Disabled"
                    HorizontalScrollMode="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    VerticalScrollMode="Enabled">
                    <StackPanel Spacing="8">
                        <ItemsRepeater
                            x:Name="ServiceTreeRepeater"
                            HorizontalAlignment="Stretch">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Padding="14"
                                        HorizontalAlignment="Stretch"
                                        Background="{Binding CardBackgroundBrush}"
                                        BorderBrush="{Binding CardBorderBrush}"
                                        BorderThickness="{Binding CardBorderThickness}"
                                        CornerRadius="6"
                                        Tag="{Binding}"
                                        Tapped="ServiceNode_Tapped">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="170" />
                                            </Grid.ColumnDefinitions>

                                            <Border
                                                Width="4"
                                                Height="36"
                                                VerticalAlignment="Top"
                                                Background="{Binding StatusAccentBrush}"
                                                CornerRadius="2" />

                                            <Button
                                                Grid.Column="1"
                                                Width="32"
                                                Height="32"
                                                Padding="0"
                                                VerticalAlignment="Top"
                                                Click="ToggleNodeButton_Click"
                                                Tag="{Binding}">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="18"
                                                    Text="{Binding ExpandGlyph}" />
                                            </Button>

                                            <StackPanel Grid.Column="2" Spacing="4">
                                                <TextBlock
                                                    Style="{StaticResource SectionTitleTextBlockStyle}"
                                                    Text="{Binding Title}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Style="{StaticResource MetadataValueTextBlockStyle}"
                                                    Text="{Binding WindowsServicesDisplayNameText}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <StackPanel
                                                    Orientation="Horizontal"
                                                    Spacing="8"
                                                    Visibility="{Binding ProcessSummaryVisibility}">
                                                    <TextBlock
                                                        FontSize="12"
                                                        FontWeight="SemiBold"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="{Binding ProcessesSummaryText}" />
                                                    <TextBlock
                                                        FontSize="12"
                                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                        Text="{Binding ProcessNamesSummaryText}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </StackPanel>

                                            <StackPanel Grid.Column="3" Spacing="4">
                                                <TextBlock
                                                    Style="{StaticResource ColumnLabelTextBlockStyle}"
                                                    Text="Состояние" />
                                                <Border
                                                    MinHeight="28"
                                                    Padding="8,0"
                                                    HorizontalAlignment="Left"
                                                    Background="{Binding StatusBadgeBackgroundBrush}"
                                                    BorderBrush="{Binding StatusAccentBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="10">
                                                    <StackPanel
                                                        VerticalAlignment="Center"
                                                        Orientation="Horizontal"
                                                        Spacing="6">
                                                        <Ellipse
                                                            Width="7"
                                                            Height="7"
                                                            VerticalAlignment="Center"
                                                            Fill="{Binding StatusAccentBrush}" />
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            FontWeight="SemiBold"
                                                            LineHeight="20"
                                                            Text="{Binding StateDisplayName}"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>

                                            <StackPanel Grid.Column="4" Spacing="4">
                                                <TextBlock
                                                    Style="{StaticResource ColumnLabelTextBlockStyle}"
                                                    Text="Порты" />
                                                <TextBlock
                                                    LineHeight="20"
                                                    Text="{Binding PortsText}"
                                                    TextWrapping="WrapWholeWords" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>

                        <Border
                            x:Name="ServerAgentSetupCard"
                            Padding="12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Visibility="{Binding Visibility}">
                            <StackPanel Spacing="8">
                                <StackPanel Spacing="2">
                                    <TextBlock
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        Text="{Binding TitleText}" />
                                </StackPanel>

                                <ItemsRepeater ItemsSource="{Binding Candidates}">
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate>
                                            <Grid
                                                MinHeight="40"
                                                ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource SectionTitleTextBlockStyle}"
                                                    Text="{Binding VersionText}" />

                                                <TextBlock
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource MetadataMonoTextBlockStyle}"
                                                    Text="{Binding RagentPathText}"
                                                    TextTrimming="CharacterEllipsis" />

                                                <Button
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    AutomationProperties.Name="Создать службу Windows для агента 1С"
                                                    Click="ConfigureServerAgentServiceButton_Click"
                                                    Tag="{Binding}">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <SymbolIcon Symbol="Add" />
                                                        <TextBlock Text="Создать службу..." />
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Grid
                    Grid.Column="1"
                    RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border
                        x:Name="AdministrationToolsCard"
                        Grid.Row="1"
                        Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <StackPanel Spacing="12">
                            <StackPanel Spacing="2">
                                <TextBlock
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Text="Инструменты администрирования" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    LineHeight="20"
                                    Text="{Binding SummaryText}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <Grid ColumnSpacing="16" RowSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Spacing="2">
                                    <TextBlock
                                        Style="{StaticResource SectionTitleTextBlockStyle}"
                                        Text="rac.exe" />
                                    <TextBlock
                                        Style="{StaticResource ColumnLabelTextBlockStyle}"
                                        Text="команды" />
                                </StackPanel>

                                <Border
                                    Grid.Column="1"
                                    MinHeight="26"
                                    Padding="8,0"
                                    HorizontalAlignment="Left"
                                    Background="{Binding RacStatusBadgeBackgroundBrush}"
                                    BorderBrush="{Binding RacStatusAccentBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                    <StackPanel
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="6">
                                        <Ellipse
                                            Width="7"
                                            Height="7"
                                            VerticalAlignment="Center"
                                            Fill="{Binding RacStatusAccentBrush}" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            LineHeight="18"
                                            Text="{Binding RacStateText}" />
                                    </StackPanel>
                                </Border>

                                <TextBlock
                                    Grid.Column="2"
                                    LineHeight="20"
                                    Text="{Binding RacVersionText}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Grid.Column="3"
                                    Style="{StaticResource MetadataMonoTextBlockStyle}"
                                    Text="{Binding RacPathText}"
                                    TextTrimming="CharacterEllipsis" />

                                <StackPanel Grid.Row="1" Spacing="2">
                                    <TextBlock
                                        Style="{StaticResource SectionTitleTextBlockStyle}"
                                        Text="ras.exe" />
                                    <TextBlock
                                        Style="{StaticResource ColumnLabelTextBlockStyle}"
                                        Text="сервер" />
                                </StackPanel>

                                <Border
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    MinHeight="26"
                                    Padding="8,0"
                                    HorizontalAlignment="Left"
                                    Background="{Binding RasStatusBadgeBackgroundBrush}"
                                    BorderBrush="{Binding RasStatusAccentBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                    <StackPanel
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="6">
                                        <Ellipse
                                            Width="7"
                                            Height="7"
                                            VerticalAlignment="Center"
                                            Fill="{Binding RasStatusAccentBrush}" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            LineHeight="18"
                                            Text="{Binding RasStateText}" />
                                    </StackPanel>
                                </Border>

                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="2"
                                    LineHeight="20"
                                    Text="{Binding RasVersionText}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="3"
                                    Style="{StaticResource MetadataMonoTextBlockStyle}"
                                    Text="{Binding RasPathText}"
                                    TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border
                        x:Name="ClustersCard"
                        Grid.Row="3"
                        Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <StackPanel Spacing="12">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Spacing="2">
                                    <TextBlock
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        Text="Кластеры" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        LineHeight="20"
                                        Text="{Binding MessageText}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <StackPanel
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <Button
                                        x:Name="StartTemporaryRasButton"
                                        AutomationProperties.Name="Запустить временный RAS"
                                        Click="StartTemporaryRasButton_Click"
                                        Visibility="{Binding StartTemporaryRasVisibility}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <SymbolIcon Symbol="Play" />
                                            <TextBlock Text="Запустить RAS" />
                                        </StackPanel>
                                    </Button>

                                    <Button
                                        x:Name="StopTemporaryRasButton"
                                        AutomationProperties.Name="Остановить временный RAS"
                                        Click="StopTemporaryRasButton_Click"
                                        Visibility="{Binding StopTemporaryRasVisibility}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <SymbolIcon Symbol="Stop" />
                                            <TextBlock Text="Остановить RAS" />
                                        </StackPanel>
                                    </Button>

                                    <Border
                                        MinHeight="28"
                                        Padding="8,0"
                                        Background="{Binding StatusBadgeBackgroundBrush}"
                                        BorderBrush="{Binding StatusAccentBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                        <StackPanel
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            Spacing="6">
                                            <Ellipse
                                                Width="7"
                                                Height="7"
                                                VerticalAlignment="Center"
                                                Fill="{Binding StatusAccentBrush}" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                LineHeight="18"
                                                Text="{Binding StatusText}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <Grid ColumnSpacing="16" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock
                                    Style="{StaticResource MetadataLabelTextBlockStyle}"
                                    Text="Адрес RAS" />
                                <TextBlock
                                    Grid.Column="1"
                                    Style="{StaticResource MetadataMonoTextBlockStyle}"
                                    Text="{Binding AddressText}"
                                    TextTrimming="CharacterEllipsis" />

                                <TextBlock
                                    Grid.Row="1"
                                    Style="{StaticResource MetadataLabelTextBlockStyle}"
                                    Text="Агент сервера" />
                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Style="{StaticResource MetadataMonoTextBlockStyle}"
                                    Text="{Binding AgentAddressText}"
                                    TextTrimming="CharacterEllipsis" />
                            </Grid>

                            <ItemsRepeater
                                ItemsSource="{Binding Clusters}"
                                Visibility="{Binding ClustersVisibility}">
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Padding="0,12"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="0,1,0,0">
                                            <StackPanel Spacing="12">
                                                <Grid ColumnSpacing="16">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="360" />
                                                        <ColumnDefinition Width="170" />
                                                        <ColumnDefinition Width="120" />
                                                        <ColumnDefinition Width="150" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Spacing="4">
                                                        <TextBlock
                                                            Style="{StaticResource SectionTitleTextBlockStyle}"
                                                            Text="{Binding NameText}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <TextBlock
                                                            Style="{StaticResource MetadataMonoTextBlockStyle}"
                                                            Text="{Binding UuidText}"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="1" Spacing="4">
                                                        <TextBlock
                                                            Style="{StaticResource ColumnLabelTextBlockStyle}"
                                                            Text="Адрес" />
                                                        <TextBlock
                                                            LineHeight="20"
                                                            Text="{Binding AddressText}"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2" Spacing="4">
                                                        <TextBlock
                                                            Style="{StaticResource ColumnLabelTextBlockStyle}"
                                                            Text="Безопасность" />
                                                        <TextBlock
                                                            LineHeight="20"
                                                            Text="{Binding SecurityLevelText}"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="3" Spacing="4">
                                                        <TextBlock
                                                            Style="{StaticResource ColumnLabelTextBlockStyle}"
                                                            Text="Балансировка" />
                                                        <TextBlock
                                                            LineHeight="20"
                                                            Text="{Binding LoadBalancingModeText}"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Grid>

                                                <TextBlock
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    LineHeight="20"
                                                    Text="{Binding DetailsMessageText}"
                                                    TextWrapping="WrapWholeWords"
                                                    Visibility="{Binding DetailsMessageVisibility}" />

                                                <StackPanel Spacing="14">
                                                    <StackPanel Spacing="8">
                                                        <StackPanel Spacing="2">
                                                            <TextBlock
                                                                Style="{StaticResource SectionTitleTextBlockStyle}"
                                                                Text="Рабочие серверы" />
                                                            <TextBlock
                                                                Style="{StaticResource ColumnLabelTextBlockStyle}"
                                                                Text="{Binding ServersSummaryText}" />
                                                        </StackPanel>

                                                        <ItemsRepeater
                                                            ItemsSource="{Binding Servers}"
                                                            Visibility="{Binding ServersVisibility}">
                                                            <ItemsRepeater.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border
                                                                        Padding="0,8"
                                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                        BorderThickness="0,1,0,0">
                                                                        <Grid ColumnSpacing="12">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="340" />
                                                                                <ColumnDefinition Width="170" />
                                                                                <ColumnDefinition Width="220" />
                                                                                <ColumnDefinition Width="190" />
                                                                            </Grid.ColumnDefinitions>

                                                                            <StackPanel Spacing="4">
                                                                                <TextBlock
                                                                                    Style="{StaticResource SectionTitleTextBlockStyle}"
                                                                                    Text="{Binding NameText}"
                                                                                    TextTrimming="CharacterEllipsis" />
                                                                                <TextBlock
                                                                                    Style="{StaticResource MetadataMonoTextBlockStyle}"
                                                                                    Text="{Binding UuidText}"
                                                                                    TextTrimming="CharacterEllipsis" />
                                                                            </StackPanel>

                                                                            <StackPanel Grid.Column="1" Spacing="4">
                                                                                <TextBlock
                                                                                    Style="{StaticResource ColumnLabelTextBlockStyle}"
                                                                                    Text="Агент" />
                                                                                <TextBlock
                                                                                    LineHeight="20"
                                                                                    Text="{Binding AgentAddressText}"
                                                                                    TextTrimming="CharacterEllipsis" />
                                                                            </StackPanel>

                                                                            <StackPanel Grid.Column="2" Spacing="4">
                                                                                <TextBlock
                                                                                    Style="{StaticResource ColumnLabelTextBlockStyle}"
                                                                                    Text="Порты" />
                                                                                <TextBlock
                                                                                    LineHeight="20"
                                                                                    Text="{Binding PortsText}"
                                                                                    TextWrapping="WrapWholeWords" />
                                                                            </StackPanel>

                                                                            <StackPanel Grid.Column="3" Spacing="4">
                                                                                <TextBlock
                                                                                    Style="{StaticResource ColumnLabelTextBlockStyle}"
                                                                                    Text="Назначение" />
                                                                                <TextBlock
                                                                                    LineHeight="20"
                                                                                    Text="{Binding UsageText}"
                                                                                    TextWrapping="WrapWholeWords" />
                                                                                <TextBlock
                                                                                    Style="{StaticResource ColumnLabelTextBlockStyle}"
                                                                                    Text="{Binding LimitsText}"
                                                                                    TextWrapping="WrapWholeWords" />
                                                                            </StackPanel>
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsRepeater.ItemTemplate>
                                                        </ItemsRepeater>
                                                    </StackPanel>

                                                    <StackPanel Spacing="8">
                                                        <Grid ColumnSpacing="12">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <StackPanel Spacing="2">
                                                                <TextBlock
                                                                    Style="{StaticResource SectionTitleTextBlockStyle}"
                                                                    Text="Информационные базы" />
                                                                <TextBlock
                                                                    Style="{StaticResource ColumnLabelTextBlockStyle}"
                                                                    Text="{Binding InfobasesSummaryText}" />
                                                            </StackPanel>

                                                            <Button
                                                                Grid.Column="1"
                                                                AutomationProperties.Name="Создать информационную базу"
                                                                Click="OpenCreateInfobaseDialogButton_Click"
                                                                Tag="{Binding}">
                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                    <SymbolIcon Symbol="Add" />
                                                                    <TextBlock Text="Создать базу" />
                                                                </StackPanel>
                                                            </Button>
                                                        </Grid>

                                                        <Border
                                                            Padding="14"
                                                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="6"
                                                            Visibility="{Binding InfobaseEmptyStateVisibility}">
                                                            <StackPanel Spacing="4">
                                                                <TextBlock
                                                                    FontWeight="SemiBold"
                                                                    LineHeight="20"
                                                                    Text="Баз пока нет" />
                                                                <TextBlock
                                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                    LineHeight="20"
                                                                    Text="Новая информационная база будет создана в выбранном кластере."
                                                                    TextWrapping="WrapWholeWords" />
                                                            </StackPanel>
                                                        </Border>

                                                        <ItemsRepeater
                                                            ItemsSource="{Binding Infobases}"
                                                            Visibility="{Binding InfobasesVisibility}">
                                                            <ItemsRepeater.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border
                                                                        Padding="0,8"
                                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                        BorderThickness="0,1,0,0">
                                                                        <Grid ColumnSpacing="12">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="1.4*" />
                                                                                <ColumnDefinition Width="1.5*" />
                                                                                <ColumnDefinition Width="1.1*" />
                                                                                <ColumnDefinition Width="220" />
                                                                            </Grid.ColumnDefinitions>

                                                                            <StackPanel Spacing="4">
                                                                                <TextBlock
                                                                                    Style="{StaticResource SectionTitleTextBlockStyle}"
                                                                                    Text="{Binding NameText}"
                                                                                    TextTrimming="CharacterEllipsis" />
                                                                                <TextBlock
                                                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                                    LineHeight="20"
                                                                                    Text="{Binding DescriptionText}"
                                                                                    TextWrapping="WrapWholeWords" />
                                                                                <TextBlock
                                                                                    Style="{StaticResource MetadataMonoTextBlockStyle}"
                                                                                    Text="{Binding UuidText}"
                                                                                    TextTrimming="CharacterEllipsis" />
                                                                            </StackPanel>

                                                                            <StackPanel Grid.Column="1" Spacing="4">
                                                                                <TextBlock
                                                                                    Style="{StaticResource ColumnLabelTextBlockStyle}"
                                                                                    Text="Хранилище данных" />
                                                                                <TextBlock
                                                                                    LineHeight="20"
                                                                                    Text="{Binding DatabaseText}"
                                                                                    TextWrapping="WrapWholeWords" />
                                                                            </StackPanel>

                                                                            <StackPanel Grid.Column="2" Spacing="4">
                                                                                <TextBlock
                                                                                    Style="{StaticResource ColumnLabelTextBlockStyle}"
                                                                                    Text="Безопасность" />
                                                                                <TextBlock
                                                                                    LineHeight="20"
                                                                                    Text="{Binding SecurityAndLicensingText}"
                                                                                    TextWrapping="WrapWholeWords" />
                                                                            </StackPanel>

                                                                            <StackPanel Grid.Column="3" Spacing="10">
                                                                                <TextBlock
                                                                                    Style="{StaticResource ColumnLabelTextBlockStyle}"
                                                                                    Text="Управление" />
                                                                                <Grid
                                                                                    MinHeight="40"
                                                                                    ColumnSpacing="12">
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="*" />
                                                                                        <ColumnDefinition Width="Auto" />
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <StackPanel
                                                                                        VerticalAlignment="Center"
                                                                                        Spacing="2">
                                                                                        <TextBlock
                                                                                            FontWeight="SemiBold"
                                                                                            Text="Вход пользователей" />
                                                                                        <TextBlock
                                                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                                            Text="{Binding SessionsAccessText}" />
                                                                                    </StackPanel>
                                                                                    <ToggleSwitch
                                                                                        Grid.Column="1"
                                                                                        MinWidth="0"
                                                                                        HorizontalAlignment="Right"
                                                                                        VerticalAlignment="Center"
                                                                                        OffContent=""
                                                                                        OnContent=""
                                                                                        Tag="{Binding}"
                                                                                        Loaded="InfobaseSessionsToggleSwitch_Loaded"
                                                                                        Unloaded="InfobaseSessionsToggleSwitch_Unloaded" />
                                                                                </Grid>
                                                                                <Grid
                                                                                    MinHeight="40"
                                                                                    ColumnSpacing="12">
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="*" />
                                                                                        <ColumnDefinition Width="Auto" />
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <StackPanel
                                                                                        VerticalAlignment="Center"
                                                                                        Spacing="2">
                                                                                        <TextBlock
                                                                                            FontWeight="SemiBold"
                                                                                            Text="Регламентные задания" />
                                                                                        <TextBlock
                                                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                                            Text="{Binding ScheduledJobsAccessText}" />
                                                                                    </StackPanel>
                                                                                    <ToggleSwitch
                                                                                        Grid.Column="1"
                                                                                        MinWidth="0"
                                                                                        HorizontalAlignment="Right"
                                                                                        VerticalAlignment="Center"
                                                                                        OffContent=""
                                                                                        OnContent=""
                                                                                        Tag="{Binding}"
                                                                                        Loaded="InfobaseScheduledJobsToggleSwitch_Loaded"
                                                                                        Unloaded="InfobaseScheduledJobsToggleSwitch_Unloaded" />
                                                                                </Grid>
                                                                            </StackPanel>
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsRepeater.ItemTemplate>
                                                        </ItemsRepeater>
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </Border>

                    <Border
                        x:Name="LicensesCard"
                        Grid.Row="2"
                        Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <StackPanel Spacing="12">
                            <StackPanel Spacing="2">
                                <TextBlock
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Text="Лицензии" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    LineHeight="20"
                                    Text="{Binding LicenseSummaryText}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <Border
                                Padding="14"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Visibility="{Binding LicensesEmptyStateVisibility}">
                                <StackPanel Spacing="4">
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        LineHeight="20"
                                        Text="Занятые лицензии не обнаружены" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        LineHeight="20"
                                        Text="rac не вернул лицензии, занятые рабочими процессами или пользовательскими сеансами."
                                        TextWrapping="WrapWholeWords" />
                                </StackPanel>
                            </Border>

                            <ItemsRepeater
                                ItemsSource="{Binding LicenseClusters}"
                                Visibility="{Binding LicenseClustersVisibility}">
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Padding="0,12"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="0,1,0,0">
                                            <StackPanel Spacing="10">
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Spacing="2">
                                                        <TextBlock
                                                            Style="{StaticResource SectionTitleTextBlockStyle}"
                                                            Text="{Binding NameText}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <TextBlock
                                                            Style="{StaticResource ColumnLabelTextBlockStyle}"
                                                            Text="{Binding AddressText}"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>

                                                    <TextBlock
                                                        Grid.Column="1"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        LineHeight="20"
                                                        Text="{Binding OccupiedLicensesSummaryText}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </Grid>

                                                <ItemsRepeater ItemsSource="{Binding OccupiedLicenseUsages}">
                                                    <ItemsRepeater.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border
                                                                Padding="0,10"
                                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                BorderThickness="0,1,0,0">
                                                                <Grid ColumnSpacing="16">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="140" />
                                                                        <ColumnDefinition Width="120" />
                                                                        <ColumnDefinition Width="320" />
                                                                        <ColumnDefinition Width="150" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>

                                                                    <StackPanel Spacing="4">
                                                                        <TextBlock
                                                                            Style="{StaticResource SectionTitleTextBlockStyle}"
                                                                            Text="{Binding OwnerKindText}" />
                                                                        <TextBlock
                                                                            Style="{StaticResource ColumnLabelTextBlockStyle}"
                                                                            Text="{Binding LicenseKindText}"
                                                                            TextWrapping="WrapWholeWords" />
                                                                    </StackPanel>

                                                                    <StackPanel Grid.Column="1" Spacing="2">
                                                                        <TextBlock
                                                                            Style="{StaticResource ColumnLabelTextBlockStyle}"
                                                                            Text="Расход" />
                                                                        <TextBlock
                                                                            FontSize="20"
                                                                            FontWeight="SemiBold"
                                                                            LineHeight="26"
                                                                            Text="{Binding UsageText}" />
                                                                        <TextBlock
                                                                            Style="{StaticResource ColumnLabelTextBlockStyle}"
                                                                            Text="{Binding UsageCaptionText}" />
                                                                    </StackPanel>

                                                                    <StackPanel Grid.Column="2" Spacing="4">
                                                                        <TextBlock
                                                                            Style="{StaticResource ColumnLabelTextBlockStyle}"
                                                                            Text="Потребители" />
                                                                        <TextBlock
                                                                            LineHeight="20"
                                                                            Text="{Binding ConsumersText}" />
                                                                        <TextBlock
                                                                            Style="{StaticResource ColumnLabelTextBlockStyle}"
                                                                            Text="{Binding ConsumersDetailText}"
                                                                            TextWrapping="WrapWholeWords" />
                                                                    </StackPanel>

                                                                    <StackPanel Grid.Column="3" Spacing="4">
                                                                        <TextBlock
                                                                            Style="{StaticResource ColumnLabelTextBlockStyle}"
                                                                            Text="Режим" />
                                                                        <TextBlock
                                                                            LineHeight="20"
                                                                            Text="{Binding ConsumptionModeText}" />
                                                                        <TextBlock
                                                                            Style="{StaticResource ColumnLabelTextBlockStyle}"
                                                                            Text="{Binding ExplanationText}"
                                                                            TextWrapping="WrapWholeWords" />
                                                                    </StackPanel>

                                                                    <StackPanel Grid.Column="4" Spacing="4">
                                                                        <TextBlock
                                                                            Style="{StaticResource ColumnLabelTextBlockStyle}"
                                                                            Text="Источник" />
                                                                        <TextBlock
                                                                            LineHeight="20"
                                                                            Text="{Binding SourceText}"
                                                                            TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock
                                                                            Style="{StaticResource MetadataMonoTextBlockStyle}"
                                                                            Text="{Binding SourceDetailText}"
                                                                            TextTrimming="CharacterEllipsis" />
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsRepeater.ItemTemplate>
                                                </ItemsRepeater>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </Border>

                    <Border
                        x:Name="ComponentDetailsCard"
                        Grid.Row="0"
                        MaxHeight="420"
                        Padding="20"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Visibility="Collapsed">
                    <ScrollViewer
                        HorizontalScrollBarVisibility="Disabled"
                        HorizontalScrollMode="Disabled"
                        VerticalScrollBarVisibility="Auto"
                        VerticalScrollMode="Enabled">
                        <StackPanel Spacing="18">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Spacing="4">
                                    <TextBlock
                                        FontSize="22"
                                        FontWeight="SemiBold"
                                        Text="{Binding Title}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{Binding WindowsServicesDisplayNameText}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>

                            <Grid
                                ColumnSpacing="8"
                                Visibility="{Binding ServiceActionsVisibility}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel
                                    x:Name="ServiceActionsPanel"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <Button
                                        AutomationProperties.Name="Запустить службу 1С"
                                        Click="StartServiceButton_Click"
                                        IsEnabled="{Binding CanStartService}"
                                        Tag="{Binding}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <SymbolIcon Symbol="Play" />
                                            <TextBlock Text="Запустить" />
                                        </StackPanel>
                                    </Button>

                                    <Button
                                        AutomationProperties.Name="Остановить службу 1С"
                                        Click="StopServiceButton_Click"
                                        IsEnabled="{Binding CanStopService}"
                                        Tag="{Binding}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <SymbolIcon Symbol="Stop" />
                                            <TextBlock Text="Остановить" />
                                        </StackPanel>
                                    </Button>

                                    <Button
                                        AutomationProperties.Name="Перезапустить службу 1С"
                                        Click="RestartServiceButton_Click"
                                        IsEnabled="{Binding CanRestartService}"
                                        Tag="{Binding}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <SymbolIcon Symbol="Refresh" />
                                            <TextBlock Text="Перезапустить" />
                                        </StackPanel>
                                    </Button>

                                    <Button
                                        AutomationProperties.Name="Открыть службы Windows"
                                        Click="OpenWindowsServicesButton_Click"
                                        Tag="{Binding}"
                                        ToolTipService.ToolTip="Открыть службы Windows">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <SymbolIcon Symbol="Setting" />
                                            <TextBlock Text="Службы Windows" />
                                        </StackPanel>
                                    </Button>

                                    <Button
                                        AutomationProperties.Name="Удалить службу 1С"
                                        Click="DeleteServiceButton_Click"
                                        IsEnabled="{Binding CanDeleteService}"
                                        Tag="{Binding}"
                                        ToolTipService.ToolTip="Удалить службу Windows">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <SymbolIcon Symbol="Delete" />
                                            <TextBlock Text="Удалить..." />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <ProgressRing
                                    x:Name="ServiceCommandProgress"
                                    Grid.Column="1"
                                    Width="28"
                                    Height="28"
                                    IsActive="False"
                                    Visibility="Collapsed" />
                            </Grid>

                            <Grid ColumnSpacing="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.1*" />
                                    <ColumnDefinition Width="0.8*" />
                                    <ColumnDefinition Width="1.5*" />
                                    <ColumnDefinition Width="1.2*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Spacing="4">
                                    <TextBlock
                                        Style="{StaticResource ColumnLabelTextBlockStyle}"
                                        Text="Состояние" />
                                    <Border
                                        MinHeight="28"
                                        Padding="8,0"
                                        HorizontalAlignment="Left"
                                        Background="{Binding StatusBadgeBackgroundBrush}"
                                        BorderBrush="{Binding StatusAccentBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                        <StackPanel
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            Spacing="6">
                                            <Ellipse
                                                Width="7"
                                                Height="7"
                                                VerticalAlignment="Center"
                                                Fill="{Binding StatusAccentBrush}" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontWeight="SemiBold"
                                                LineHeight="20"
                                                Text="{Binding StateDisplayName}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        LineHeight="18"
                                        Text="{Binding StartModeDisplayName}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock
                                        Style="{StaticResource ColumnLabelTextBlockStyle}"
                                        Text="Версия" />
                                    <TextBlock
                                        LineHeight="20"
                                        Text="{Binding VersionText}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Spacing="4">
                                    <TextBlock
                                        Style="{StaticResource ColumnLabelTextBlockStyle}"
                                        Text="Порты" />
                                    <TextBlock
                                        LineHeight="20"
                                        Text="{Binding PortsText}"
                                        TextWrapping="WrapWholeWords" />
                                </StackPanel>

                                <StackPanel Grid.Column="3" Spacing="4">
                                    <TextBlock
                                        Style="{StaticResource ColumnLabelTextBlockStyle}"
                                        Text="Учётная запись" />
                                    <TextBlock
                                        LineHeight="20"
                                        Text="{Binding AccountText}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>

                            <Border
                                Height="1"
                                Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                            <StackPanel Spacing="10">
                                <TextBlock
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Text="Имена в Windows" />

                                <Grid ColumnSpacing="16" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock
                                        Style="{StaticResource MetadataLabelTextBlockStyle}"
                                        Text="В списке служб" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Style="{StaticResource MetadataValueTextBlockStyle}"
                                        Text="{Binding WindowsServicesDisplayNameText}"
                                        TextWrapping="WrapWholeWords" />

                                    <TextBlock
                                        Grid.Row="1"
                                        Style="{StaticResource MetadataLabelTextBlockStyle}"
                                        Text="Имя службы"
                                        Visibility="{Binding TaskManagerServiceNameVisibility}" />
                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Style="{StaticResource MetadataMonoTextBlockStyle}"
                                        Text="{Binding TaskManagerServiceNameText}"
                                        TextWrapping="WrapWholeWords"
                                        Visibility="{Binding TaskManagerServiceNameVisibility}" />
                                </Grid>
                            </StackPanel>

                            <Border
                                Height="1"
                                Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                            <StackPanel Spacing="10">
                                <TextBlock
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Text="Файлы и запуск" />

                                <Grid ColumnSpacing="12" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock
                                        Style="{StaticResource MetadataLabelTextBlockStyle}"
                                        Text="Каталог данных" />
                                    <Button
                                        Grid.Column="1"
                                        AutomationProperties.Name="Копировать каталог данных"
                                        CommandParameter="Каталог данных"
                                        Click="CopyValueButton_Click"
                                        Style="{StaticResource CopyIconButtonStyle}"
                                        Tag="{Binding DataDirectoryText}"
                                        ToolTipService.ToolTip="Копировать каталог данных">
                                        <SymbolIcon Symbol="Copy" />
                                    </Button>
                                    <TextBlock
                                        Grid.Column="2"
                                        Style="{StaticResource MetadataMonoTextBlockStyle}"
                                        Text="{Binding DataDirectoryText}"
                                        TextWrapping="Wrap" />

                                    <TextBlock
                                        Grid.Row="1"
                                        Style="{StaticResource MetadataLabelTextBlockStyle}"
                                        Text="Исполняемый файл" />
                                    <Button
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        AutomationProperties.Name="Копировать исполняемый файл"
                                        CommandParameter="Исполняемый файл"
                                        Click="CopyValueButton_Click"
                                        Style="{StaticResource CopyIconButtonStyle}"
                                        Tag="{Binding ExecutablePathText}"
                                        ToolTipService.ToolTip="Копировать исполняемый файл">
                                        <SymbolIcon Symbol="Copy" />
                                    </Button>
                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="2"
                                        Style="{StaticResource MetadataMonoTextBlockStyle}"
                                        Text="{Binding ExecutablePathText}"
                                        TextWrapping="Wrap" />

                                    <TextBlock
                                        Grid.Row="2"
                                        Style="{StaticResource MetadataLabelTextBlockStyle}"
                                        Text="Аргументы" />
                                    <Button
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        AutomationProperties.Name="Копировать аргументы"
                                        CommandParameter="Аргументы"
                                        Click="CopyValueButton_Click"
                                        Style="{StaticResource CopyIconButtonStyle}"
                                        Tag="{Binding ArgumentsText}"
                                        ToolTipService.ToolTip="Копировать аргументы">
                                        <SymbolIcon Symbol="Copy" />
                                    </Button>
                                    <TextBlock
                                        Grid.Row="2"
                                        Grid.Column="2"
                                        Style="{StaticResource MetadataMonoTextBlockStyle}"
                                        Text="{Binding ArgumentsText}"
                                        TextWrapping="Wrap" />
                                </Grid>
                            </StackPanel>

                            <Border
                                Height="1"
                                Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                            <StackPanel Spacing="10">
                                <TextBlock
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Text="Процессы" />

                                <ItemsRepeater ItemsSource="{Binding Processes}">
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate>
                                            <Border
                                                Padding="0,10"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="0,1,0,0">
                                                <Grid ColumnSpacing="16">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="2*" />
                                                        <ColumnDefinition Width="80" />
                                                        <ColumnDefinition Width="90" />
                                                        <ColumnDefinition Width="2*" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Spacing="4">
                                                        <TextBlock
                                                            Style="{StaticResource SectionTitleTextBlockStyle}"
                                                            Text="{Binding KindDisplayName}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <TextBlock
                                                            Style="{StaticResource MetadataValueTextBlockStyle}"
                                                            Text="{Binding Name}"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="1" Spacing="4">
                                                        <TextBlock
                                                            Style="{StaticResource ColumnLabelTextBlockStyle}"
                                                            Text="PID" />
                                                        <TextBlock
                                                            FontWeight="SemiBold"
                                                            LineHeight="20"
                                                            Text="{Binding ProcessIdText}"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2" Spacing="4">
                                                        <TextBlock
                                                            Style="{StaticResource ColumnLabelTextBlockStyle}"
                                                            Text="Родитель" />
                                                        <TextBlock
                                                            LineHeight="20"
                                                            Text="{Binding ParentProcessIdText}"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="3" Spacing="4">
                                                        <TextBlock
                                                            Style="{StaticResource ColumnLabelTextBlockStyle}"
                                                            Text="Назначение" />
                                                        <TextBlock
                                                            LineHeight="20"
                                                            Text="{Binding RoleText}"
                                                            TextWrapping="WrapWholeWords" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>

            <Border
                x:Name="EmptyState"
                Width="640"
                MaxWidth="640"
                Padding="20"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Visibility="Collapsed">
                <StackPanel Spacing="6">
                    <TextBlock
                        FontSize="18"
                        FontWeight="SemiBold"
                        Text="Службы и процессы 1С не найдены" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Проверяются службы Windows и серверные процессы ragent, rmngr, rphost, ras и dbgs."
                        TextWrapping="WrapWholeWords" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>

<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="AdminConsoleFor1C.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="4">
                <TextBlock
                    FontSize="28"
                    FontWeight="SemiBold"
                    Text="Службы" />
                <TextBlock
                    x:Name="StatusText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Готово" />
            </StackPanel>

            <ProgressRing
                x:Name="RefreshProgress"
                Grid.Column="1"
                Width="32"
                Height="32"
                IsActive="False"
                Visibility="Collapsed" />

            <Button
                x:Name="RefreshButton"
                Grid.Column="2"
                Click="RefreshButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Refresh" />
                    <TextBlock Text="Обновить" />
                </StackPanel>
            </Button>
        </Grid>

        <InfoBar
            x:Name="ErrorInfoBar"
            Grid.Row="1"
            IsOpen="False"
            Severity="Error"
            Title="Не удалось получить список служб" />

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border
                Padding="12,8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <Grid MinWidth="1320" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock FontWeight="SemiBold" Text="Тип" />
                    <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="Состояние" />
                    <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="Версия" />
                    <TextBlock Grid.Column="3" FontWeight="SemiBold" Text="Порт" />
                    <TextBlock Grid.Column="4" FontWeight="SemiBold" Text="RegPort" />
                    <TextBlock Grid.Column="5" FontWeight="SemiBold" Text="Диапазон" />
                    <TextBlock Grid.Column="6" FontWeight="SemiBold" Text="PID" />
                    <TextBlock Grid.Column="7" FontWeight="SemiBold" Text="Учётная запись" />
                    <TextBlock Grid.Column="8" FontWeight="SemiBold" Text="Имя службы" />
                </Grid>
            </Border>

            <ListView
                x:Name="ServicesList"
                Grid.Row="1"
                Margin="0,8,0,0"
                SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid MinWidth="1320" Padding="8,10" RowSpacing="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{Binding KindDisplayName}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{Binding State}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Text="{Binding VersionText}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="3" Text="{Binding AgentPortText}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="4" Text="{Binding RegPortText}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="5" Text="{Binding PortRangeText}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="6" Text="{Binding ProcessIdText}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="7" Text="{Binding AccountText}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="8" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />

                            <TextBlock
                                Grid.Row="1"
                                Grid.ColumnSpan="9"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{Binding DisplayName}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Grid.Row="2"
                                Grid.ColumnSpan="9"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{Binding DataDirectoryText}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Grid.Row="3"
                                Grid.ColumnSpan="9"
                                FontFamily="Consolas"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Text="{Binding RawCommandLine}"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>

<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="AdminConsoleFor1C.App.SessionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AdminConsoleFor1C.App"
    xmlns:ic="using:FluentIcons.WinUI" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
    <Page.Resources>
        <!-- Keep the WinUI item template, including its native check box and focus states. -->
        <Style x:Key="SessionRowStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="0,1" />
        </Style>
        <Style x:Key="SessionCellStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>
    </Page.Resources>
    <Grid Padding="24,24,24,16" RowSpacing="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel Spacing="4">
            <TextBlock Text="Сеансы" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="{Binding Status}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <InfoBar IsOpen="{Binding HasDiscoveryError}" Message="{Binding DiscoveryError}" Severity="Warning" IsClosable="False" />
        </StackPanel>
        <Border x:Name="SessionWorkspace" Grid.Row="1" CornerRadius="8" BorderThickness="1"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <CommandBar Padding="4,0" HorizontalAlignment="Left" Background="Transparent"
                    DefaultLabelPosition="Right" IsDynamicOverflowEnabled="True">
                    <AppBarButton Label="Обновить" Command="{Binding RefreshScopeCommand}" AutomationProperties.AutomationId="RefreshSessions">
                        <AppBarButton.Icon><ic:FluentIcon Icon="ArrowClockwise" IconSize="Size20" /></AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton Label="Добавить сервер" Click="AddConnection_Click" IsEnabled="{Binding CanEdit}" AutomationProperties.AutomationId="AddServerConnection">
                        <AppBarButton.Icon><ic:FluentIcon Icon="Add" IconSize="Size20" /></AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton Label="Подключение" IsEnabled="{Binding CanEdit}" AutomationProperties.AutomationId="ServerConnectionMenu">
                        <AppBarButton.Icon><ic:FluentIcon Icon="Settings" IconSize="Size20" /></AppBarButton.Icon>
                        <AppBarButton.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Обновить все серверы" Command="{Binding RefreshAllCommand}" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Изменить подключение…" Click="EditConnection_Click" IsEnabled="{Binding CanManageSelected}" />
                                <MenuFlyoutItem Text="Удалить подключение…" Click="RemoveConnection_Click" IsEnabled="{Binding CanRemoveSelected}" />
                            </MenuFlyout>
                        </AppBarButton.Flyout>
                    </AppBarButton>
                    <AppBarToggleButton x:Name="AutoRefresh" Label="Автообновление" IsChecked="{Binding IsAutoRefreshEnabled, Mode=TwoWay}"
                        ToolTipService.ToolTip="Обновлять текущую область каждые 15 секунд, повторяя попытку после ошибки">
                        <AppBarToggleButton.Icon><ic:FluentIcon Icon="ArrowSync" IconSize="Size20" /></AppBarToggleButton.Icon>
                    </AppBarToggleButton>
                    <AppBarSeparator />
                    <AppBarButton x:Name="TerminateButton" Label="Завершить" Click="Terminate_Click" IsEnabled="False"
                        AutomationProperties.AutomationId="TerminateSelectedSessions">
                        <AppBarButton.Icon><ic:FluentIcon Icon="DismissCircle" IconSize="Size20" /></AppBarButton.Icon>
                    </AppBarButton>
                </CommandBar>
                <InfoBar Grid.Row="1" IsOpen="{Binding HasMessage}" Message="{Binding Message}" Severity="{Binding MessageSeverity}" IsClosable="False" />
                <InfoBar Grid.Row="2" IsOpen="{Binding HasConnectionError}" Message="{Binding SelectedConnectionError}"
                    Severity="{Binding ConnectionErrorSeverity}" IsClosable="False" Title="Подключение" />
                <Grid x:Name="SessionFilters" Grid.Row="3" Margin="16,8,16,16" ColumnSpacing="16" RowSpacing="12"
                    MaxWidth="1320" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
                    <ComboBox x:Name="SessionServerFilter" Header="Сервер" ItemsSource="{Binding ConnectionFilters}" IsEnabled="{Binding CanEdit}"
                        SelectedItem="{Binding ConnectionFilter, Mode=TwoWay}" ItemTemplate="{StaticResource ServerScopeFilterTemplate}"
                        SelectionChanged="Connections_SelectionChanged"
                        HorizontalAlignment="Stretch" AutomationProperties.AutomationId="ServerFilter" />
                    <ComboBox x:Name="SessionClusterFilter" Grid.Column="1" Header="Кластер" ItemsSource="{Binding Clusters}" IsEnabled="{Binding CanEdit}"
                        SelectedItem="{Binding SelectedCluster, Mode=TwoWay}" ItemTemplate="{StaticResource ServerDataScopeFilterTemplate}"
                        HorizontalAlignment="Stretch" AutomationProperties.AutomationId="SessionClusterFilter" />
                    <ComboBox x:Name="SessionInfobaseFilter" Grid.Column="2" Header="База" ItemsSource="{Binding InfobaseFilters}" IsEnabled="{Binding CanEdit}"
                        SelectedItem="{Binding InfobaseFilter, Mode=TwoWay}" ItemTemplate="{StaticResource ServerDataScopeFilterTemplate}"
                        HorizontalAlignment="Stretch" AutomationProperties.AutomationId="SessionInfobaseFilter" />
                    <TextBox x:Name="SessionSearchBox" Grid.Column="3" Header="Поиск" PlaceholderText="Пользователь, компьютер или приложение" IsEnabled="{Binding CanEdit}"
                        Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="SessionSearch" />
                </Grid>
                <Grid Grid.Row="4">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <Grid MinWidth="1410">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <Grid Padding="40,10,12,10" ColumnSpacing="12" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="185" /><ColumnDefinition Width="240" /><ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="120" /><ColumnDefinition Width="70" /><ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="140" /><ColumnDefinition Width="230" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Пользователь" /><TextBlock Grid.Column="1" Text="База" />
                                <TextBlock Grid.Column="2" Text="Компьютер" /><TextBlock Grid.Column="3" Text="Приложение" />
                                <TextBlock Grid.Column="4" Text="Сеанс" /><TextBlock Grid.Column="5" Text="Начало" />
                                <TextBlock Grid.Column="6" Text="Активность" /><TextBlock Grid.Column="7" Text="Сервер" />
                            </Grid>
                            <ListView x:Name="SessionsList" Grid.Row="1" ItemsSource="{Binding Sessions}" SelectionMode="Multiple"
                                IsMultiSelectCheckBoxEnabled="True" SelectionChanged="Sessions_SelectionChanged"
                                ItemContainerStyle="{StaticResource SessionRowStyle}" AutomationProperties.AutomationId="ServerSessionsList">
                                <ListView.Resources>
                                    <StaticResource x:Key="ListViewItemBackgroundSelected" ResourceKey="AccentFillColorDefaultBrush" />
                                    <StaticResource x:Key="ListViewItemBackgroundSelectedPointerOver" ResourceKey="AccentFillColorSecondaryBrush" />
                                    <StaticResource x:Key="ListViewItemBackgroundSelectedPressed" ResourceKey="AccentFillColorTertiaryBrush" />
                                    <StaticResource x:Key="ListViewItemForegroundSelected" ResourceKey="TextOnAccentFillColorPrimaryBrush" />
                                    <StaticResource x:Key="ListViewItemForegroundSelectedPointerOver" ResourceKey="TextOnAccentFillColorPrimaryBrush" />
                                    <StaticResource x:Key="ListViewItemForegroundSelectedPressed" ResourceKey="TextOnAccentFillColorPrimaryBrush" />
                                </ListView.Resources>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:ServerSessionRow">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="185" /><ColumnDefinition Width="240" /><ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="120" /><ColumnDefinition Width="70" /><ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="140" /><ColumnDefinition Width="230" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding UserName}" Style="{StaticResource SessionCellStyle}" ToolTipService.ToolTip="{Binding UserName}" />
                                            <TextBlock Grid.Column="1" Text="{Binding InfobaseName}" Style="{StaticResource SessionCellStyle}" ToolTipService.ToolTip="{Binding InfobaseName}" />
                                            <TextBlock Grid.Column="2" Text="{Binding Host}" Style="{StaticResource SessionCellStyle}" ToolTipService.ToolTip="{Binding Host}" />
                                            <TextBlock Grid.Column="3" Text="{Binding Application}" Style="{StaticResource SessionCellStyle}" />
                                            <TextBlock Grid.Column="4" Text="{Binding SessionId}" Style="{StaticResource SessionCellStyle}" />
                                            <TextBlock Grid.Column="5" Text="{Binding StartedAt}" Style="{StaticResource SessionCellStyle}" />
                                            <TextBlock Grid.Column="6" Text="{Binding LastActiveAt}" Style="{StaticResource SessionCellStyle}" />
                                            <TextBlock Grid.Column="7" Text="{Binding ServerText}" Style="{StaticResource SessionCellStyle}" ToolTipService.ToolTip="{Binding ServerDetails}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </ScrollViewer>
                    <TextBlock x:Name="EmptyState" Text="Нажмите «Обновить», чтобы получить сеансы выбранной области."
                        HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="24"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
                </Grid>
                <Grid Grid.Row="5" Padding="16,10" ColumnSpacing="12" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock x:Name="SelectionStatus" Text="Выберите сеансы для завершения" Style="{StaticResource CaptionTextBlockStyle}" />
                    <ProgressRing Grid.Column="1" IsActive="{Binding IsBusy}" Width="16" Height="16" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
